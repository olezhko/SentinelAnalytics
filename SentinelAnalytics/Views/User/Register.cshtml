@page
@using Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="min-h-[90vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-[2.5rem] border border-slate-200 shadow-xl relative overflow-hidden">
        <!-- Subtle background element -->
        <div class="absolute -top-12 -right-12 w-32 h-32 bg-indigo-50 rounded-full blur-2xl opacity-60"></div>

        <div class="text-center relative z-10">
            <div class="mx-auto h-12 w-12 bg-indigo-600 rounded-2xl flex items-center justify-center text-white font-black text-xl shadow-lg shadow-indigo-600/20 mb-6 transition-transform hover:scale-110">S</div>
            <h2 class="text-3xl font-black text-slate-900 tracking-tight">Join the Network</h2>
            <p class="mt-2 text-sm font-medium text-slate-500 uppercase tracking-widest">Provision Your Enterprise Console</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-8 space-y-6 relative z-10">
            <div asp-validation-summary="All" class="text-rose-600 text-[10px] font-bold bg-rose-50 p-4 rounded-xl border border-rose-100"></div>

            <div class="space-y-5">
                <div class="space-y-1">
                    <label asp-for="Input.Email" class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1"></label>
                    <input asp-for="Input.Email" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 font-medium transition-all" placeholder="work-email@company.com" autocomplete="username" />
                    <span asp-validation-for="Input.Email" class="text-rose-500 text-[10px] font-bold"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="Input.Password" class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1"></label>
                    <input asp-for="Input.Password" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 font-medium transition-all" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="text-rose-500 text-[10px] font-bold"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="Input.ConfirmPassword" class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Confirm Security Credential</label>
                    <input asp-for="Input.ConfirmPassword" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 font-medium transition-all" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-rose-500 text-[10px] font-bold"></span>
                </div>
            </div>

            <div class="pt-4">
                <button id="registerSubmit" type="submit" class="group relative w-full flex justify-center py-4 px-4 bg-slate-900 text-white font-black rounded-2xl hover:bg-indigo-600 transition-all shadow-lg shadow-slate-900/10 active:scale-[0.98]">
                    Establish Account
                </button>
            </div>

            <p class="text-[10px] text-slate-400 text-center leading-relaxed">
                By creating an account, you agree to our
                <a asp-controller="Home" asp-action="TermsOfService" class="font-bold text-slate-600 hover:text-indigo-600">Terms of Service</a>
                and
                <a asp-controller="Home" asp-action="Privacy" class="font-bold text-slate-600 hover:text-indigo-600">Privacy Policy</a>.
            </p>
        </form>

        <div class="mt-6 pt-6 border-t border-slate-100 text-center">
            <p class="text-xs text-slate-400 font-medium">
                Already part of the network?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-indigo-600 hover:underline">Sign in to console</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

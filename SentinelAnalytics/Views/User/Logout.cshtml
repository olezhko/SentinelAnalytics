@page
@using Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="min-h-[70vh] flex items-center justify-center p-6 bg-slate-50">
    <div class="max-w-md w-full text-center space-y-8 bg-white p-12 rounded-[3rem] border border-slate-200 shadow-xl">
        <div class="flex justify-center">
            <div class="w-20 h-20 bg-slate-900 rounded-[2rem] flex items-center justify-center text-3xl shadow-2xl">👋</div>
        </div>
        <div class="space-y-2">
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">Session Ended</h1>
            <p class="text-slate-500 font-medium">You have been successfully signed out of the Sentinel Console.</p>
        </div>

        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <button type="submit" class="w-full py-4 bg-indigo-600 text-white font-black rounded-2xl shadow-lg shadow-indigo-600/10 hover:bg-indigo-500 transition-all">Sign out</button>
        </form>

        <div class="pt-4">
            <a href="/" class="text-xs font-black text-slate-400 uppercase tracking-widest hover:text-indigo-600 transition-colors">Return to Landing Page</a>
        </div>
    </div>
</div>
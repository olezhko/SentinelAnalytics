@model CrashGroupDetailsViewModel
@{
    var crashes = Model.Crashes;
    var unresolvedIds = crashes.Where(c => !c.IsResolved).Select(c => c.Id).ToList();
}

<div class="p-8 border-b border-slate-100 flex items-center justify-between">
    <div>
        <h3 class="text-2xl font-black text-slate-900">@crashes[0].ExceptionName</h3>
        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">@crashes.Count occurrence@(crashes.Count == 1 ? "" : "s") in this group</p>
    </div>
    <button type="button" onclick="closeGroupModal()" class="w-10 h-10 flex items-center justify-center rounded-xl hover:bg-slate-100 text-slate-400 transition-all">✕</button>
</div>

<div class="px-8 pt-6 flex gap-2 overflow-x-auto">
    @for (int i = 0; i < crashes.Count; i++)
    {
        var c = crashes[i];
        <button type="button" data-tab="tab-@i" data-crash-id="@c.Id"
                class="group-tab-btn shrink-0 px-4 py-2 rounded-t-xl text-xs font-black uppercase tracking-wider transition-all @(i == 0 ? "bg-indigo-600 text-white" : "bg-slate-50 text-slate-500 hover:bg-slate-100")">
            @c.Timestamp.ToString("MMM dd, HH:mm") @(c.IsResolved ? "✓" : "")
        </button>
    }
</div>

<div class="p-8 overflow-y-auto space-y-8 max-h-[50vh]">
    @for (int i = 0; i < crashes.Count; i++)
    {
        var c = crashes[i];
        <div class="group-tab-panel space-y-6 @(i == 0 ? "" : "hidden")" data-tab-panel="tab-@i">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">App Version</p>
                    <p class="font-bold text-slate-900">@c.Session.AppVersion</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">OS Version</p>
                    <p class="font-bold text-slate-900">@c.Session.OsVersion</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Device</p>
                    <p class="font-bold text-slate-900">@c.Session.DeviceModel</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Status</p>
                    @if (c.IsResolved)
                    {
                        <span class="px-2 py-0.5 bg-emerald-100 text-emerald-600 text-[9px] font-black uppercase rounded tracking-wider">Resolved</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 bg-rose-100 text-rose-600 text-[9px] font-black uppercase rounded tracking-wider">Unresolved</span>
                    }
                </div>
            </div>

            <div class="space-y-3">
                <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">Error Message</h4>
                <div class="p-4 bg-rose-50 border border-rose-100 rounded-2xl">
                    <p class="text-rose-900 font-medium leading-relaxed">@c.Message</p>
                </div>
            </div>

            <div class="space-y-3">
                <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">Stack Trace</h4>
                <pre class="bg-slate-900 text-indigo-300 p-6 rounded-2xl font-mono text-xs overflow-x-auto border border-slate-800 leading-relaxed">@c.StackTrace</pre>
            </div>
        </div>
    }
</div>

<div class="p-8 border-t border-slate-100 bg-slate-50/50 space-y-6">
    <a id="groupOpenIncidentLink" asp-controller="Dashboard" asp-action="CrashDetails" asp-route-id="@crashes[0].Id"
       class="flex items-center justify-center gap-2 w-full py-4 bg-indigo-600 text-white text-center font-black rounded-2xl shadow-xl shadow-indigo-600/20 hover:bg-indigo-500 transition-all">
        Open Full Incident Page <span>→</span>
    </a>

    @if (unresolvedIds.Count > 0)
    {
        <form asp-controller="Dashboard" asp-action="ResolveGroup" method="post" class="space-y-4">
            <input type="hidden" name="projectId" value="@Model.ProjectId" />
            <input type="hidden" name="appVersion" value="@Model.AppVersion" />
            <input type="hidden" name="timePeriod" value="@Model.TimePeriod" />
            <input type="hidden" name="severity" value="@Model.Severity" />
            <input type="hidden" name="resolutionStatus" value="@Model.ResolutionStatus" />
            <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />
            @foreach (var id in unresolvedIds)
            {
                <input type="hidden" name="ids" value="@id" />
            }
            <div class="space-y-1">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Resolution Summary</label>
                <textarea name="comment" required placeholder="Describe what was fixed..." class="block w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500 font-medium transition-all h-24"></textarea>
            </div>
            <button type="submit" class="w-full py-4 bg-slate-900 text-white font-black rounded-2xl shadow-lg hover:bg-emerald-600 transition-all active:scale-[0.98]">
                Resolve all @unresolvedIds.Count unresolved crash@(unresolvedIds.Count == 1 ? "" : "es") in this group
            </button>
        </form>
    }
    else
    {
        <div class="flex items-center justify-center gap-3 text-emerald-600 font-bold py-4">
            <span>✅</span> All crashes in this group are resolved.
        </div>
    }
</div>

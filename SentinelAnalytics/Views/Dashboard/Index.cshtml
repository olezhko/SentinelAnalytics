@using SentinelAnalytics.Data.Entities
@model DashboardStatsViewModel
@{
    ViewData["Title"] = @Model.ProjectName + " - Project Overview";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <nav class="flex items-center gap-3 text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">
            <a asp-controller="Analytics" asp-action="Index" asp-route-projectId="@Model.CurrentProjectId" class="hover:text-indigo-600 transition-colors">Analytics</a>
            <span>/</span>
            <span class="text-slate-900">Crashes</span>
        </nav>
    </div>

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-8">
        <div>
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">@Model.ProjectName - Crashes Overview</h1>
            <p class="text-slate-500 font-medium">Monitoring platform health and stability</p>
        </div>
        <div class="flex gap-3">
            <button type="submit" form="filterForm" asp-action="ExportReport" class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-indigo-600/20 hover:bg-indigo-500 transition-all flex items-center gap-2">
                <span>📥</span> Export Health Report (.csv)
            </button>
        </div>
    </div>

    <!-- Stability Banner -->
    <div class="mb-12 bg-white p-10 rounded-[3rem] border border-slate-200 shadow-xl flex flex-col lg:flex-row items-center gap-12 relative overflow-hidden">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-indigo-50 rounded-full blur-3xl opacity-50"></div>

        <!-- Stability Gauge (CSS-only for this example) -->
        <div class="relative w-48 h-48 flex items-center justify-center flex-shrink-0">
            <svg class="w-full h-full transform -rotate-90">
                <circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="16" fill="transparent" class="text-slate-100" />
                <circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="16" fill="transparent"
                        stroke-dasharray="552.92"
                        stroke-dashoffset="@(552.92 * (1 - Model.CrashFreeUserRate / 100))"
                        class="@(Model.CrashFreeUserRate > 99 ? "text-emerald-500" : "text-amber-500") transition-all duration-1000 ease-out" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <span class="text-4xl font-black text-slate-900 leading-none">@Model.CrashFreeUserRate.ToString("F1")%</span>
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest mt-1">Stability</span>
            </div>
        </div>

        <div class="flex-1 space-y-4 text-center lg:text-left relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-50 text-indigo-600 rounded-full text-[10px] font-black uppercase tracking-widest border border-indigo-100">
                Network Intelligence Active
            </div>
            <h1 class="text-4xl font-black text-slate-900 tracking-tight">
                Your Infrastructure is
                <span class="@(Model.CrashFreeUserRate > 99 ? "text-emerald-600" : "text-amber-600")">
                    @(Model.CrashFreeUserRate > 99.5 ? "Stable" : Model.CrashFreeUserRate > 98 ? "Operational" : "Degraded")
                </span>
            </h1>
            <p class="text-slate-500 font-medium text-lg leading-relaxed max-w-2xl">
                We've analyzed session patterns for <span class="font-black text-slate-900">@Model.ActiveSessionsCount.ToString("N0")</span> active sessions.
                <span class="font-black text-slate-900">@Model.UniqueSessionsImpacted</span> sessions have encountered critical failure points in the last reporting period.
            </p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm mb-10">
        <form id="filterForm" method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-7 gap-6 items-end">
            <input type="hidden" name="projectId" value="@Model.CurrentProjectId" />
            
            <div class="md:col-span-2 space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Full-Text Search</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs">🔍</span>
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" placeholder="Search stack, messages, or fixes..." class="w-full bg-slate-50 border border-slate-100 rounded-xl pl-10 pr-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
                </div>
            </div>

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">App Version</label>
                <select name="appVersion" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer">
                    <option value="All">All Versions</option>
                    @foreach (var version in Model.AvailableVersions)
                    {
                        <option value="@version" selected="@(Model.SelectedVersion == version ? "selected" : null)">@version</option>
                    }
                </select>
            </div>

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Resolution Status</label>
                <select name="resolutionStatus" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer">
                    <option value="all" selected="@(Model.SelectedResolution == "all" ? "selected" : null)">All Statuses</option>
                    <option value="unresolved" selected="@(Model.SelectedResolution == "unresolved" ? "selected" : null)">⚠️ Unresolved Only</option>
                    <option value="resolved" selected="@(Model.SelectedResolution == "resolved" ? "selected" : null)">✅ Resolved Only</option>
                </select>
            </div>

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Time Period</label>
                <select name="timePeriod" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer">
                    <option value="all" selected="@(Model.SelectedPeriod == "all" ? "selected" : null)">All</option>
                    <option value="last24h" selected="@(Model.SelectedPeriod == "last24h" ? "selected" : null)">Last 24 Hours</option>
                    <option value="last7d" selected="@(Model.SelectedPeriod == "last7d" ? "selected" : null)">Last 7 Days</option>
                    <option value="last30d" selected="@(Model.SelectedPeriod == "last30d" ? "selected" : null)">Last 30 Days</option>
                </select>
            </div>

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Severity Level</label>
                <select name="severity" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer">
                    <option value="">All Severities</option>
                    @foreach (var s in Enum.GetValues(typeof(Severity)))
                    {
                        <option value="@s" selected="@(Model.SelectedSeverity.ToString() == s.ToString() ? "selected" : null)">@s</option>
                    }
                </select>
            </div>

            <div>
                <button type="submit" class="w-full bg-slate-900 text-white px-5 py-2.5 rounded-xl text-xs font-black shadow-lg hover:bg-slate-800 transition-all">
                    Apply Filters
                </button>
            </div>
        </form>
    </div>

    <!-- Trends Chart Placeholder -->
    <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm mb-10">
        @{
            var periodLabel = Model.SelectedPeriod switch
            {
                "last24h" => "Last 24 Hours",
                "last7d"  => "Last 7 Days",
                "last30d" => "Last 30 Days",
                _         => "All Time"
            };
        }
        <h3 class="text-lg font-bold text-slate-900 mb-6">Incident Trends (@periodLabel)</h3>
        <div class="flex items-end gap-2 h-48">
            @if (Model.DailyTrends.Count != 0)
            {
                var max = Model.DailyTrends.Max(item => item.Count);
                var containerHeight = 192.0;
                var pixelPerItem = max == 0 ? 0 : containerHeight / max;
                pixelPerItem = Math.Min(pixelPerItem, 10);

                @foreach (var stat in Model.DailyTrends)
                {
                    <div class="flex-1 group relative">
                        <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">@stat.Count</div>
                        <div class="bg-indigo-600/20 group-hover:bg-indigo-600 rounded-t-lg transition-all" style="height: @(stat.Count * pixelPerItem)px"></div>
                        <p class="text-[10px] text-slate-400 font-bold uppercase text-center mt-2">@stat.Date</p>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Recent Crashes Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-10">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/30 gap-4 flex-wrap">
            <h3 class="text-lg font-black text-slate-900">Recent Crashes</h3>
            <div class="flex items-center gap-3">
                <span id="selectionCount" class="text-[10px] font-black text-indigo-600 uppercase tracking-widest hidden"></span>
                <button type="button" id="bulkResolveBtn" disabled onclick="submitBulkAction('/Dashboard/ResolveGroup', '@Model.CurrentProjectId')"
                        class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all bg-slate-900 text-white disabled:opacity-30 disabled:cursor-not-allowed hover:enabled:bg-emerald-600">
                    ✅ Mark as Resolved
                </button>
                <button type="button" id="bulkIgnoreBtn" disabled onclick="submitBulkAction('/Dashboard/IgnoreGroup', '@Model.CurrentProjectId')"
                        class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all bg-white border border-slate-200 text-slate-600 disabled:opacity-30 disabled:cursor-not-allowed hover:enabled:bg-slate-100">
                    🚫 Mark as Ignored
                </button>
                <span class="px-3 py-1 bg-white border border-slate-200 rounded-lg text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                    @(Model.GroupedCrashes.Count) crash groups listed
                </span>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] border-b border-slate-100">
                        <th class="pl-6 pr-2 py-4 w-8">
                            <input type="checkbox" id="selectAllCheckbox" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
                        </th>
                        <th class="px-6 py-4">Exception</th>
                        <th class="px-6 py-4">Message</th>
                        <th class="px-6 py-4">Last Crash</th>
                        <th class="px-6 py-4 text-center">Count</th>
                        <th class="px-8 py-4 text-right">Investigation</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.GroupedCrashes != null && Model.GroupedCrashes.Any())
                    {
                        @foreach (var group in Model.GroupedCrashes)
                        {
                            var idsCsv = string.Join(",", group.Reports.Select(r => r.Id));
                            <tr class="hover:bg-slate-50/80 transition-colors cursor-pointer group">
                                <td class="pl-6 pr-2 py-4">
                                    <input type="checkbox" class="group-select-checkbox rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" data-ids="@idsCsv" />
                                </td>
                                <td class="px-6 py-4" onclick="openGroupModal('@idsCsv', '@Model.CurrentProjectId')">
                                    <div class="flex items-center gap-3">
                                        <div class="w-2 h-2 rounded-full @(group.Reports.Any(r => r.Severity == Severity.Critical) ? "bg-rose-500" : "bg-amber-500")"></div>

                                        <div class="flex items-center gap-2">
                                            <p class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">@group.Exception.Exception</p>
                                            @if (group.AllResolved)
                                            {
                                                <span class="text-[9px] font-black text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100 uppercase">Resolved</span>
                                            }
                                            @if (group.AllIgnored)
                                            {
                                                <span class="text-[9px] font-black text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200 uppercase">Ignored</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-500 truncate max-w-xs" onclick="openGroupModal('@idsCsv', '@Model.CurrentProjectId')">@group.Message</td>
                                <td class="px-6 py-4 text-[11px] text-slate-400 font-mono" onclick="openGroupModal('@idsCsv', '@Model.CurrentProjectId')">@group.LastCrashAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="px-6 py-4 text-center" onclick="openGroupModal('@idsCsv', '@Model.CurrentProjectId')">
                                    <span class="inline-flex items-center justify-center min-w-[2rem] px-2 py-1 bg-slate-100 text-slate-700 rounded-lg text-xs font-black">@group.OccurrenceCount</span>
                                </td>
                                <td class="px-8 py-5 text-right">
                                    <button type="button" onclick="openGroupModal('@idsCsv', '@Model.CurrentProjectId')" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 text-slate-700 hover:bg-indigo-600 hover:text-white hover:border-indigo-600 rounded-xl text-xs font-black transition-all shadow-sm">
                                        Details <span>→</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-8 py-16 text-center text-slate-400 italic">No reports found matching the selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Crash Group Details Modal -->
<div id="crashGroupModal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden overflow-hidden">
    <div class="bg-white w-full max-w-4xl rounded-3xl shadow-2xl flex flex-col max-h-[90vh] animate-in zoom-in duration-300">
        <div id="groupModalBody">
            <div class="p-16 text-center text-slate-400 font-bold">Loading…</div>
        </div>
    </div>
</div>

<script>
    function openGroupModal(idsCsv, projectId) {
        const ids = idsCsv.split(',');
        const params = new URLSearchParams(window.location.search);
        params.set('projectId', projectId);
        params.delete('ids');
        ids.forEach(id => params.append('ids', id));

        const body = document.getElementById('groupModalBody');
        body.innerHTML = '<div class="p-16 text-center text-slate-400 font-bold">Loading…</div>';
        document.getElementById('crashGroupModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        fetch('/Dashboard/GroupDetails?' + params.toString())
            .then(r => r.ok ? r.text() : Promise.reject())
            .then(html => { body.innerHTML = html; })
            .catch(() => { body.innerHTML = '<div class="p-16 text-center text-rose-500 font-bold">Failed to load crash group.</div>'; });
    }

    function closeGroupModal() {
        document.getElementById('crashGroupModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Close on escape
    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeGroupModal();
    });

    // Delegated tab switching — content is swapped via AJAX, so listener lives on the static container
    document.getElementById('groupModalBody').addEventListener('click', (e) => {
        const btn = e.target.closest('.group-tab-btn');
        if (!btn) return;
        const target = btn.dataset.tab;

        document.querySelectorAll('.group-tab-btn').forEach(b => {
            const active = b === btn;
            b.classList.toggle('bg-indigo-600', active);
            b.classList.toggle('text-white', active);
            b.classList.toggle('bg-slate-50', !active);
            b.classList.toggle('text-slate-500', !active);
        });
        document.querySelectorAll('.group-tab-panel').forEach(p => {
            p.classList.toggle('hidden', p.dataset.tabPanel !== target);
        });

        const link = document.getElementById('groupOpenIncidentLink');
        if (link && btn.dataset.crashId) {
            link.href = `/Dashboard/CrashDetails/${btn.dataset.crashId}`;
        }
    });

    // Row selection checkboxes + bulk action toolbar
    function updateBulkToolbar() {
        const rowCheckboxes = document.querySelectorAll('.group-select-checkbox');
        const checked = document.querySelectorAll('.group-select-checkbox:checked');

        const countEl = document.getElementById('selectionCount');
        countEl.textContent = `${checked.length} selected`;
        countEl.classList.toggle('hidden', checked.length === 0);

        document.getElementById('bulkResolveBtn').disabled = checked.length === 0;
        document.getElementById('bulkIgnoreBtn').disabled = checked.length === 0;

        const selectAll = document.getElementById('selectAllCheckbox');
        selectAll.checked = rowCheckboxes.length > 0 && checked.length === rowCheckboxes.length;
        selectAll.indeterminate = checked.length > 0 && checked.length < rowCheckboxes.length;
    }

    document.getElementById('selectAllCheckbox').addEventListener('change', (e) => {
        document.querySelectorAll('.group-select-checkbox').forEach(cb => { cb.checked = e.target.checked; });
        updateBulkToolbar();
    });

    document.querySelector('tbody').addEventListener('change', (e) => {
        if (e.target.classList.contains('group-select-checkbox')) {
            updateBulkToolbar();
        }
    });

    function submitBulkAction(actionUrl, projectId) {
        const ids = new Set();
        document.querySelectorAll('.group-select-checkbox:checked').forEach(cb => {
            cb.dataset.ids.split(',').forEach(id => ids.add(id));
        });
        if (ids.size === 0) return;

        const params = new URLSearchParams(window.location.search);
        const form = document.createElement('form');
        form.method = 'post';
        form.action = actionUrl;

        const addField = (name, value) => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
        };

        addField('projectId', projectId);
        ['appVersion', 'timePeriod', 'severity', 'resolutionStatus', 'searchQuery'].forEach(key => {
            const value = params.get(key);
            if (value !== null) addField(key, value);
        });
        ids.forEach(id => addField('ids', id));

        document.body.appendChild(form);
        form.submit();
    }
</script>
@using SentinelAnalytics.Data.Entities
@model DashboardStatsViewModel
@{
    ViewData["Title"] = @Model.ProjectName + " - Project Overview";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-8">
        <div>
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">@Model.ProjectName - Project Overview</h1>
            <p class="text-slate-500 font-medium">Monitoring platform health and stability</p>
        </div>
        <div class="flex gap-3">
            <button type="submit" form="filterForm" asp-action="ExportReport" class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-lg shadow-indigo-600/20 hover:bg-indigo-500 transition-all flex items-center gap-2">
                <span>📥</span> Export Health Report (.csv)
            </button>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm mb-10">
        <form id="filterForm" method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-4 gap-6 items-end">
            <input type="hidden" name="projectId" value="@Model.CurrentProjectId" />
            
            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">App Version</label>
                <select name="appVersion" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer">
                    <option value="All">All Versions</option>
                    @foreach (var version in Model.AvailableVersions)
                    {
                        <option value="@version" selected="@(Model.SelectedVersion == version ? "selected" : null)">@version</option>
                    }
                </select>
            </div>

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Time Period</label>
                <select name="timePeriod" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer">
                    <option value="all" selected="@(Model.SelectedPeriod == "all" ? "selected" : null)">All</option>
                    <option value="last24h" selected="@(Model.SelectedPeriod == "last24h" ? "selected" : null)">Last 24 Hours</option>
                    <option value="last7d" selected="@(Model.SelectedPeriod == "last7d" ? "selected" : null)">Last 7 Days</option>
                    <option value="last30d" selected="@(Model.SelectedPeriod == "last30d" ? "selected" : null)">Last 30 Days</option>
                </select>
            </div>

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Severity Level</label>
                <select name="severity" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer">
                    <option value="">All Severities</option>
                    @foreach (var s in Enum.GetValues(typeof(Severity)))
                    {
                        <option value="@s" selected="@(Model.SelectedSeverity.ToString() == s.ToString() ? "selected" : null)">@s</option>
                    }
                </select>
            </div>

            <div>
                <button type="submit" class="w-full bg-slate-900 text-white px-5 py-2.5 rounded-xl text-xs font-black shadow-lg hover:bg-slate-800 transition-all">
                    Apply Filters
                </button>
            </div>
        </form>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Total Crashes</p>
            <h2 class="text-4xl font-black text-slate-900">@Model.TotalCrashes</h2>
@*             <div class="mt-4 flex items-center gap-1 text-emerald-600 text-xs font-bold">
                <span>↑ 12.5%</span>
                <span class="text-slate-400 font-normal">vs last month</span>
            </div> *@
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Total Sessions</p>
            <h2 class="text-4xl font-black text-slate-900">@Model.ActiveSessionsCount</h2>
@*             <div class="mt-4 flex items-center gap-1 text-emerald-600 text-xs font-bold">
                <span>↑ 4.2%</span>
                <span class="text-slate-400 font-normal">growing</span>
            </div> *@
        </div>
@*         <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Crash-Free Rate</p>
            <h2 class="text-4xl font-black text-emerald-600">99.8%</h2>
            <div class="mt-4 flex items-center gap-1 text-emerald-600 text-xs font-bold">
                <span>Excellent</span>
            </div>
        </div> *@
@*         <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Avg Resolution Time</p>
            <h2 class="text-4xl font-black text-slate-900">2.4h</h2>
            <div class="mt-4 flex items-center gap-1 text-slate-400 text-xs font-bold">
                <span>Consistent</span>
            </div>
        </div> *@
    </div>

    <!-- Trends Chart Placeholder -->
    <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm mb-10">
        <h3 class="text-lg font-bold text-slate-900 mb-6">Incident Trends (Last 7 Days)</h3>
        <div class="flex items-end gap-2 h-48">
            @foreach (var stat in Model.DailyTrends)
            {
                <div class="flex-1 group relative">
                    <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-[10px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">@stat.Count</div>
                    <div class="bg-indigo-600/20 group-hover:bg-indigo-600 rounded-t-lg transition-all" style="height: @(stat.Count * 10)px"></div>
                    <p class="text-[10px] text-slate-400 font-bold uppercase text-center mt-2">@stat.Date</p>
                </div>
            }
        </div>
    </div>

    <!-- Recent Crashes Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-10">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/30">
            <h3 class="text-lg font-black text-slate-900">Recent Crashes</h3>
            <div class="flex items-center gap-2">
                <span class="px-3 py-1 bg-white border border-slate-200 rounded-lg text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                    @(Model.RecentCrashes.Count) incidents listed
                </span>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] border-b border-slate-100">
                        <th class="px-6 py-4">Exception</th>
                        <th class="px-6 py-4">App Version</th>
                        <th class="px-6 py-4">OS Version</th>
                        <th class="px-6 py-4">Timestamp</th>
                        <th class="px-8 py-4 text-right">Investigation</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.RecentCrashes != null && Model.RecentCrashes.Any())
                    {
                        @foreach (var crash in Model.RecentCrashes)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors cursor-pointer group">
                                <td class="px-6 py-4"
                                    onclick="openCrashModal('@crash.Id', '@crash.ExceptionName', '@crash.Message', '@crash.AppVersion', '@crash.OsVersion', '@crash.DeviceModel', '@crash.Timestamp.ToString("g")', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(crash.StackTrace))')">
                                    <div class="flex items-center gap-3">
                                        <div class="w-2 h-2 rounded-full @(crash.Severity == Severity.Critical ? "bg-rose-500" : "bg-amber-500")"></div>

                                        <div class="flex flex-col">
                                            <span class="font-bold text-slate-900 group-hover:text-indigo-600">@crash.ExceptionName</span>
                                            <p class="text-sm text-slate-500 truncate max-w-xs">@crash.Message</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-xs font-bold text-slate-600">@crash.AppVersion</td>
                                <td class="px-6 py-4 text-xs font-medium text-slate-500">@crash.OsVersion</td>
                                <td class="px-6 py-4 text-[11px] text-slate-400 font-mono">@crash.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="px-8 py-5 text-right">
                                    <a asp-controller="Dashboard" asp-action="CrashDetails" asp-route-id="@crash.Id" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 text-slate-700 hover:bg-indigo-600 hover:text-white hover:border-indigo-600 rounded-xl text-xs font-black transition-all shadow-sm">
                                        Details <span>→</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-8 py-16 text-center text-slate-400 italic">No reports found matching the selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Crash Details Modal -->
<div id="crashModal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden overflow-hidden">
    <div class="bg-white w-full max-w-4xl rounded-3xl shadow-2xl flex flex-col max-h-[90vh] animate-in zoom-in duration-300">
        <div class="p-8 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h3 id="modalException" class="text-2xl font-black text-slate-900">Exception Name</h3>
                <p id="modalTimestamp" class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Timestamp</p>
            </div>
            <button onclick="closeCrashModal()" class="w-10 h-10 flex items-center justify-center rounded-xl hover:bg-slate-100 text-slate-400 transition-all">✕</button>
        </div>
        <div class="p-8 overflow-y-auto space-y-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">App Version</p>
                    <p id="modalAppVersion" class="font-bold text-slate-900">2.4.0</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">OS Version</p>
                    <p id="modalOsVersion" class="font-bold text-slate-900">iOS 17.4</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Device</p>
                    <p id="modalDevice" class="font-bold text-slate-900">iPhone 15 Pro</p>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Status</p>
                    <span class="px-2 py-0.5 bg-rose-100 text-rose-600 text-[9px] font-black uppercase rounded tracking-wider">Unresolved</span>
                </div>
            </div>

            <div class="space-y-3">
                <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">Error Message</h4>
                <div class="p-4 bg-rose-50 border border-rose-100 rounded-2xl">
                    <p id="modalMessage" class="text-rose-900 font-medium leading-relaxed"></p>
                </div>
            </div>

            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <h4 class="text-sm font-black text-slate-900 uppercase tracking-widest">Stack Trace</h4>
                    <button class="text-[10px] font-bold text-indigo-600 hover:underline">Copy Trace</button>
                </div>
                <pre id="modalStackTrace" class="bg-slate-900 text-indigo-300 p-6 rounded-2xl font-mono text-xs overflow-x-auto border border-slate-800 leading-relaxed"></pre>
            </div>
        </div>
        <div class="p-8 border-t border-slate-100 bg-slate-50/50 flex gap-4">
            <button class="flex-1 py-4 bg-indigo-600 text-white font-bold rounded-2xl shadow-xl shadow-indigo-600/20 hover:bg-indigo-500 transition-all">Assign to Developer</button>
            <button onclick="closeCrashModal()" class="px-8 py-4 bg-white border border-slate-200 text-slate-600 font-bold rounded-2xl hover:bg-slate-100 transition-all">Close</button>
        </div>
    </div>
</div>

<script>
    function openCrashModal(id, name, msg, appVer, osVer, device, time, stack) {
        document.getElementById('modalException').innerText = name;
        document.getElementById('modalMessage').innerText = msg;
        document.getElementById('modalAppVersion').innerText = appVer;
        document.getElementById('modalOsVersion').innerText = osVer;
        document.getElementById('modalDevice').innerText = device;
        document.getElementById('modalTimestamp').innerText = time;
        document.getElementById('modalStackTrace').innerText = stack;

        document.getElementById('crashModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeCrashModal() {
        document.getElementById('crashModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Close on escape
    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeCrashModal();
    });
</script>
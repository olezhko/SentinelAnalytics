@using SentinelAnalytics.Data.Entities
@model CrashReport
@{
    ViewData["Title"] = "Crash Investigation";
    Layout = "_Layout";
    var breadcrumbs = (List<MobileEvent>)ViewBag.Breadcrumbs;
}

<div class="bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <!-- Navigation -->
        <nav class="flex items-center gap-3 text-xs font-bold text-slate-400 uppercase tracking-widest mb-10">
            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="hover:text-indigo-600 transition-colors">Dashboard</a>
            <span class="text-slate-300">/</span>
            <span class="text-slate-900">Incident #@Model.Id.ToString().Substring(0, 8)</span>
        </nav>

        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Left: Investigation & Analysis -->
            <div class="flex-1 space-y-8">

                <!-- Main Crash Info -->
                <div class="bg-white p-10 rounded-[2.5rem] border border-slate-200 shadow-sm">
                    <div class="flex flex-col md:flex-row items-start justify-between gap-6 mb-10">
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <span class="px-3 py-1 bg-rose-50 text-rose-600 text-[10px] font-black uppercase rounded-lg border border-rose-100 tracking-wider">@Model.Severity.ToString()</span>
                                <span class="text-[11px] font-mono text-slate-400">Session ID: @Model.SessionId</span>
                            </div>
                            <h1 class="text-4xl font-black text-slate-900 tracking-tight leading-none">@Model.ExceptionName</h1>
                            <p class="text-lg text-slate-500 font-medium leading-relaxed">@Model.Message</p>
                        </div>
                        <div class="text-left md:text-right bg-slate-50 p-6 rounded-3xl border border-slate-100">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-1">Occurred</p>
                            <p class="text-lg font-black text-slate-900 leading-tight">@Model.Timestamp.ToString("HH:mm:ss")</p>
                            <p class="text-xs font-bold text-slate-400">@Model.Timestamp.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-10 border-t border-slate-100">
                        <div class="space-y-1">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">App Version</p>
                            <p class="font-bold text-slate-900">@Model.AppVersion</p>
                        </div>
                        <div class="space-y-1">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Platform</p>
                            <p class="font-bold text-slate-900">@Model.OsVersion</p>
                        </div>
                        <div class="space-y-1">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Device</p>
                            <p class="font-bold text-slate-900">@Model.DeviceModel</p>
                        </div>
                        <div class="space-y-1">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Impacted User</p>
                            <p class="font-bold text-slate-900">@(Model.UserId ?? "Guest User")</p>
                        </div>
                    </div>
                </div>

                <!-- Gemini AI Analysis Section -->
                <div class="bg-gradient-to-br from-indigo-600 to-indigo-700 rounded-[2.5rem] p-10 text-white shadow-2xl shadow-indigo-600/20 relative overflow-hidden group">
                    <div class="absolute -top-24 -right-24 w-64 h-64 bg-white/10 rounded-full blur-3xl group-hover:scale-125 transition-transform duration-1000"></div>
                    <div class="relative z-10">
                        <div class="flex items-center gap-4 mb-8">
                            <div class="w-12 h-12 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center text-2xl shadow-inner">✨</div>
                            <div>
                                <h2 class="text-2xl font-black leading-none">Gemini AI Diagnostics</h2>
                                <p class="text-indigo-200 text-[10px] font-bold uppercase tracking-widest mt-1">Intelligent Root Cause Analysis</p>
                            </div>
                        </div>
                        <div class="prose prose-invert max-w-none text-indigo-50 text-sm leading-relaxed whitespace-pre-wrap">
                            @Html.Raw(ViewBag.AIAnalysis)
                        </div>
                        <div class="mt-10 pt-8 border-t border-white/10 flex flex-wrap gap-4">
                            <button class="bg-white text-indigo-600 px-6 py-3 rounded-2xl font-black text-xs hover:bg-indigo-50 transition-all transform active:scale-95">Copy Fix Suggestion</button>
                            <button class="bg-white/10 border border-white/20 text-white px-6 py-3 rounded-2xl font-black text-xs hover:bg-white/20 transition-all">Submit Feedback</button>
                        </div>
                    </div>
                </div>

                <!-- Stack Trace -->
                <div class="bg-slate-900 rounded-[2.5rem] border border-slate-800 shadow-xl overflow-hidden">
                    <div class="px-8 py-4 bg-white/5 border-b border-white/5 flex items-center justify-between">
                        <h3 class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Execution Stack Trace</h3>
                        <button onclick="navigator.clipboard.writeText(document.getElementById('stackPre').innerText)" class="text-indigo-400 text-[10px] font-bold hover:underline">Copy Full Trace</button>
                    </div>
                    <div class="p-10">
                        <pre id="stackPre" class="font-mono text-xs text-indigo-300 overflow-x-auto leading-relaxed whitespace-pre selection:bg-indigo-500 selection:text-white">@Model.StackTrace</pre>
                    </div>
                </div>
            </div>

            <!-- Right: Session Breadcrumbs -->
            <div class="w-full lg:w-[400px] flex flex-col gap-6">
                <div class="bg-white p-10 rounded-[2.5rem] border border-slate-200 shadow-sm h-full flex flex-col">
                    <h3 class="text-xl font-black text-slate-900 mb-10 flex items-center gap-3">
                        <span class="text-2xl">🛰️</span> Session Trail
                    </h3>

                    <div class="relative space-y-10 flex-1">
                        <!-- Vertical Line -->
                        <div class="absolute left-[13px] top-2 bottom-2 w-0.5 bg-slate-100"></div>

                        @if (breadcrumbs != null && breadcrumbs.Any())
                        {
                            @foreach (var ev in breadcrumbs)
                            {
                                <div class="relative flex gap-6 group">
                                    <div class="relative z-10 w-7 h-7 rounded-full bg-white border-4 border-slate-200 group-hover:border-indigo-200 transition-colors flex-shrink-0"></div>
                                    <div class="space-y-1.5 pb-2">
                                        <div class="flex items-center gap-3">
                                            <span class="text-xs font-black text-slate-900 uppercase tracking-wider group-hover:text-indigo-600 transition-colors">@ev.EventName</span>
                                            <span class="text-[10px] text-slate-400 font-mono">@ev.Timestamp.ToString("HH:mm:ss")</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(ev.PropertiesJson))
                                        {
                                            <div class="p-4 bg-slate-50 border border-slate-100 rounded-2xl text-[10px] text-slate-500 font-mono break-all max-w-[280px] shadow-inner">
                                                @ev.PropertiesJson
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-xs text-slate-400 italic py-4">No pre-crash events recorded.</p>
                        }

                        <!-- Final Crash Event Marker -->
                        <div class="relative flex gap-6">
                            <div class="relative z-10 w-7 h-7 rounded-full bg-rose-500 border-4 border-rose-100 flex-shrink-0 animate-pulse shadow-lg shadow-rose-500/30"></div>
                            <div class="space-y-1">
                                <div class="flex items-center gap-3">
                                    <span class="text-xs font-black text-rose-600 uppercase tracking-wider">CRASH DETECTED</span>
                                    <span class="text-[10px] text-rose-400 font-mono">@Model.Timestamp.ToString("HH:mm:ss")</span>
                                </div>
                                <p class="text-xs font-bold text-slate-700">@Model.ExceptionName</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-12 pt-8 border-t border-slate-100 text-center">
                        <p class="text-[10px] font-black text-slate-300 uppercase tracking-widest mb-4">Total Session Duration</p>
                        @{
                            var startTime = breadcrumbs?.FirstOrDefault()?.Timestamp ?? Model.Timestamp;
                            var duration = Model.Timestamp - startTime;
                        }
                        <p class="text-2xl font-black text-slate-900">@string.Format("{0:00}:{1:00}:{2:00}", duration.Hours, duration.Minutes, duration.Seconds)</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
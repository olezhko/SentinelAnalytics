
@model DashboardStatsViewModel
@{
    ViewData["Title"] = "Interactive Demo";
    Layout = "_Layout";
}

<div class="bg-indigo-600 py-3 text-center">
    <p class="text-xs font-bold text-white uppercase tracking-widest">
        🚀 You are viewing the <span class="underline">Interactive Live Demo</span>. No real project data is modified.
    </p>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex justify-between items-end mb-8">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-[10px] font-black uppercase rounded tracking-wider border border-emerald-200">Live Demo</span>
                <span class="text-slate-400 text-xs font-bold">Project: Sentinel E-Commerce (Global)</span>
            </div>
            <h1 class="text-3xl font-black text-slate-900">Health Dashboard</h1>
        </div>
        <div class="flex gap-3">
            <button class="bg-white border border-slate-200 px-4 py-2 rounded-xl text-sm font-bold shadow-sm hover:bg-slate-50">Custom Range</button>
            <a asp-controller="Home" asp-action="UserProfile" class="bg-indigo-600 text-white px-6 py-2 rounded-xl text-sm font-bold shadow-lg shadow-indigo-600/20 hover:bg-indigo-500 transition-all">Create Your Own Project</a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform">💥</div>
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Total Crashes</p>
            <h2 class="text-4xl font-black text-slate-900">@Model.TotalCrashes</h2>
            <div class="mt-4 flex items-center gap-1 text-rose-600 text-xs font-bold">
                <span>↑ 14.2%</span>
                <span class="text-slate-400 font-normal ml-1">last 24h</span>
            </div>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm group">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Active Users</p>
            <h2 class="text-4xl font-black text-slate-900">@Model.ActiveSessionsCount.ToString("N0")</h2>
            <div class="mt-4 flex items-center gap-1 text-emerald-600 text-xs font-bold">
                <span>↑ 3.8%</span>
                <span class="text-slate-400 font-normal ml-1">real-time</span>
            </div>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm group">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Crash-Free Users</p>
            <h2 class="text-4xl font-black text-emerald-600">99.72%</h2>
            <div class="mt-4 flex items-center gap-1 text-emerald-600 text-xs font-bold">
                <span>Healthy</span>
                <span class="text-slate-400 font-normal ml-1">Target: 99.9%</span>
            </div>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm group">
            <p class="text-slate-500 text-xs font-bold uppercase tracking-widest mb-2">Mean Time to Fix</p>
            <h2 class="text-4xl font-black text-slate-900">1.8h</h2>
            <div class="mt-4 flex items-center gap-1 text-indigo-600 text-xs font-bold">
                <span>AI Assisted</span>
            </div>
        </div>
    </div>

    <!-- Chart Row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
        <div class="lg:col-span-2 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-8">
                <h3 class="text-lg font-bold text-slate-900">Incident Volume</h3>
                <div class="flex gap-4">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-indigo-600"></div>
                        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Reports</span>
                    </div>
                </div>
            </div>
            <div class="flex items-end gap-3 h-56">
                @foreach (var stat in Model.DailyTrends)
                {
                    <div class="flex-1 flex flex-col items-center group cursor-pointer">
                        <div class="relative w-full">
                            <div class="absolute -top-10 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-[10px] font-bold px-2 py-1 rounded-lg opacity-0 group-hover:opacity-100 transition-all pointer-events-none mb-2">
                                @stat.Count Reports
                            </div>
                            <div class="bg-indigo-600 rounded-xl transition-all w-full group-hover:bg-indigo-400 group-hover:shadow-lg group-hover:shadow-indigo-600/20"
                                 style="height: @(stat.Count * 6)px"></div>
                        </div>
                        <p class="text-[9px] text-slate-400 font-bold uppercase mt-4 group-hover:text-indigo-600 transition-colors">@stat.Date</p>
                    </div>
                }
            </div>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm flex flex-col">
            <h3 class="text-lg font-bold text-slate-900 mb-6">Device Breakdown</h3>
            <div class="space-y-6 flex-grow flex flex-col justify-center">
                <div class="space-y-2">
                    <div class="flex justify-between text-xs font-bold">
                        <span class="text-slate-700">Apple iPhone 15 Pro</span>
                        <span class="text-indigo-600">45%</span>
                    </div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-indigo-600 rounded-full" style="width: 45%"></div>
                    </div>
                </div>
                <div class="space-y-2">
                    <div class="flex justify-between text-xs font-bold">
                        <span class="text-slate-700">Samsung S23 Ultra</span>
                        <span class="text-indigo-600">32%</span>
                    </div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-indigo-600 rounded-full" style="width: 32%"></div>
                    </div>
                </div>
                <div class="space-y-2">
                    <div class="flex justify-between text-xs font-bold">
                        <span class="text-slate-700">Google Pixel 8</span>
                        <span class="text-indigo-600">18%</span>
                    </div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-indigo-600 rounded-full" style="width: 18%"></div>
                    </div>
                </div>
                <div class="space-y-2">
                    <div class="flex justify-between text-xs font-bold">
                        <span class="text-slate-700">Other Devices</span>
                        <span class="text-slate-400">5%</span>
                    </div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-slate-200 rounded-full" style="width: 5%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Demo Table -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden mb-10">
        <div class="p-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/30">
            <div>
                <h3 class="text-xl font-black text-slate-900">Recent Production Issues</h3>
                <p class="text-xs text-slate-500 font-medium">Click any row to inspect the breadcrumbs and AI fix suggestions.</p>
            </div>
            <div class="flex items-center gap-2">
                <div class="px-3 py-1 bg-white border border-slate-200 rounded-lg flex items-center gap-2">
                    <div class="w-1.5 h-1.5 bg-rose-500 rounded-full"></div>
                    <span class="text-[10px] font-bold text-slate-600 uppercase">2 Critical</span>
                </div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50 text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] border-b border-slate-100">
                        <th class="px-8 py-4">Severity</th>
                        <th class="px-8 py-4">Exception / Message</th>
                        <th class="px-8 py-4">App/OS</th>
                        <th class="px-8 py-4">Device</th>
                        <th class="px-8 py-4">Occurred</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var crash in Model.RecentCrashes)
                    {
                        <tr class="hover:bg-slate-50/80 transition-all cursor-pointer group"
                            onclick="openCrashModal('@crash.Id', '@crash.ExceptionName', '@crash.Message', '@crash.AppVersion', '@crash.OsVersion', '@crash.DeviceModel', '@crash.Timestamp.ToString("MMM dd, HH:mm")', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(crash.StackTrace))')">
                            <td class="px-8 py-5">
                                <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase tracking-wider
                                        @(crash.Severity == Severity.Critical ? "bg-rose-100 text-rose-600 border border-rose-200" :
                                                                            crash.Severity == Severity.Error ? "bg-amber-100 text-amber-700 border border-amber-200" :
                                                                            "bg-slate-100 text-slate-600 border border-slate-200")">
                                    @crash.Severity
                                </span>
                            </td>
                            <td class="px-8 py-5">
                                <p class="text-sm font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">@crash.ExceptionName</p>
                                <p class="text-xs text-slate-500 truncate max-w-sm mt-0.5">@crash.Message</p>
                            </td>
                            <td class="px-8 py-5">
                                <div class="flex flex-col">
                                    <span class="text-[11px] font-bold text-slate-700">@crash.AppVersion</span>
                                    <span class="text-[10px] text-slate-400 font-medium">@crash.OsVersion</span>
                                </div>
                            </td>
                            <td class="px-8 py-5 text-xs font-bold text-slate-600">@crash.DeviceModel</td>
                            <td class="px-8 py-5 text-[11px] text-slate-400 font-mono">@crash.Timestamp.ToString("HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="p-6 bg-slate-50/30 border-t border-slate-100 flex items-center justify-center">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Showing 4 of 4 Demo Issues</p>
        </div>
    </div>
</div>

<!-- Modal logic (Reuse existing dashboard modal structure but styled for Demo) -->
<div id="crashModal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md hidden overflow-hidden">
    <div class="bg-white w-full max-w-4xl rounded-[2.5rem] shadow-2xl flex flex-col max-h-[90vh] animate-in zoom-in duration-300">
        <div class="p-10 border-b border-slate-100 flex items-center justify-between">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="px-2 py-0.5 bg-indigo-50 text-indigo-600 text-[10px] font-black uppercase rounded tracking-wider border border-indigo-100">Issue Analysis</span>
                    <p id="modalTimestamp" class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]"></p>
                </div>
                <h3 id="modalException" class="text-3xl font-black text-slate-900"></h3>
            </div>
            <button onclick="closeCrashModal()" class="w-12 h-12 flex items-center justify-center rounded-2xl bg-slate-50 hover:bg-slate-100 text-slate-400 transition-all">✕</button>
        </div>
        <div class="p-10 overflow-y-auto space-y-10">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-slate-50 p-6 rounded-3xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Environment</p>
                    <p id="modalAppVersion" class="font-bold text-slate-900 text-sm"></p>
                </div>
                <div class="bg-slate-50 p-6 rounded-3xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Platform OS</p>
                    <p id="modalOsVersion" class="font-bold text-slate-900 text-sm"></p>
                </div>
                <div class="bg-slate-50 p-6 rounded-3xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Hardware</p>
                    <p id="modalDevice" class="font-bold text-slate-900 text-sm"></p>
                </div>
                <div class="bg-slate-50 p-6 rounded-3xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Status</p>
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-rose-500"></div>
                        <span class="font-bold text-slate-900 text-sm">Active</span>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <h4 class="text-xs font-black text-slate-900 uppercase tracking-[0.3em] flex items-center gap-2">
                    <span>🚨</span> Primary Error Message
                </h4>
                <div class="p-6 bg-rose-50 border border-rose-100 rounded-3xl">
                    <p id="modalMessage" class="text-rose-900 font-semibold leading-relaxed"></p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <h4 class="text-xs font-black text-slate-900 uppercase tracking-[0.3em]">Stack Trace</h4>
                    </div>
                    <pre id="modalStackTrace" class="bg-slate-900 text-indigo-300 p-8 rounded-3xl font-mono text-[11px] overflow-x-auto border border-slate-800 leading-relaxed max-h-[300px] shadow-inner"></pre>
                </div>
                <div class="space-y-4">
                    <h4 class="text-xs font-black text-indigo-600 uppercase tracking-[0.3em] flex items-center gap-2">
                        <span>✨</span> Gemini AI Suggestion
                    </h4>
                    <div class="p-8 bg-indigo-50 border border-indigo-100 rounded-3xl space-y-4">
                        <div class="animate-pulse flex space-y-4 flex-col">
                            <div class="h-4 bg-indigo-200 rounded w-3/4"></div>
                            <div class="h-4 bg-indigo-200 rounded w-full"></div>
                            <div class="h-24 bg-indigo-200/50 rounded-2xl w-full mt-4"></div>
                        </div>
                        <p class="text-[10px] text-indigo-400 font-bold italic">Note: AI analysis is simulated in Demo mode. Real dashboard provides instant C# code fixes.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="p-10 border-t border-slate-100 bg-slate-50/50 flex gap-4">
            <a asp-controller="Home" asp-action="UserProfile" class="flex-1 py-5 bg-indigo-600 text-white font-bold rounded-3xl shadow-2xl shadow-indigo-600/30 hover:bg-indigo-500 transition-all text-center">Get Real AI Diagnostics</a>
            <button onclick="closeCrashModal()" class="px-10 py-5 bg-white border border-slate-200 text-slate-600 font-bold rounded-3xl hover:bg-slate-100 transition-all">Dismiss</button>
        </div>
    </div>
</div>

<script>
    function openCrashModal(id, name, msg, appVer, osVer, device, time, stack) {
        document.getElementById('modalException').innerText = name;
        document.getElementById('modalMessage').innerText = msg;
        document.getElementById('modalAppVersion').innerText = appVer;
        document.getElementById('modalOsVersion').innerText = osVer;
        document.getElementById('modalDevice').innerText = device;
        document.getElementById('modalTimestamp').innerText = time;
        document.getElementById('modalStackTrace').innerText = stack;

        document.getElementById('crashModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeCrashModal() {
        document.getElementById('crashModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeCrashModal();
    });
</script>
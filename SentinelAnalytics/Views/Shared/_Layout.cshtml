<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sentinel Analytics</title>

    <!-- Tailwind CSS for high-end styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .nav-link-active {
            border-bottom: 2px solid #6366f1;
            color: #6366f1;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-8">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
                        <div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-black text-sm shadow-lg shadow-indigo-600/20">S</div>
                        <span class="text-xl font-black tracking-tight text-slate-900">SENTINEL</span>
                    </a>
                    <div class="hidden md:flex items-center gap-6">
                        @* <a asp-controller="Dashboard" asp-action="Index" class="text-sm font-semibold text-slate-900 border-b-2 border-indigo-600 pb-5 translate-y-2.5">Console</a> *@
                        <a asp-controller="Home" asp-action="UserProfile" class="text-sm font-semibold text-slate-500 hover:text-indigo-600 transition-colors">Profile</a>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <partial name="_LoginPartial" />
@*                     <a asp-controller="Dashboard" asp-action="Index" class="text-sm font-bold bg-indigo-600 text-white px-5 py-2.5 rounded-xl shadow-lg shadow-indigo-600/10 hover:bg-indigo-500 transition-all">
                        Launch Dashboard
                    </a> *@
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-slate-200 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
            <div class="flex justify-center gap-6 text-sm font-bold text-slate-400 uppercase tracking-widest">
                <a asp-controller="Home" asp-action="Index" class="hover:text-indigo-600 transition-colors">Home</a>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-indigo-600 transition-colors">Privacy Policy</a>
                <a asp-controller="Home" asp-action="TermsOfService" class="hover:text-indigo-600 transition-colors">Terms of Service</a>
                <a asp-controller="Home" asp-action="Support" class="hover:text-indigo-600 transition-colors">Support</a>
            </div>
            <p class="text-sm text-slate-400 font-medium">
                &copy; @DateTime.Now.Year LATec Global Analytics. Built for enterprise mobile teams.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
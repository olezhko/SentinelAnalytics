@using SentinelAnalytics.Models.Projects
@model List<ProjectMembershipViewModel>
@{
    ViewData["Title"] = "Projects";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Console Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-8 bg-white p-10 rounded-[2.5rem] border border-slate-200 shadow-sm relative overflow-hidden">
        <div class="absolute -right-20 -top-20 w-64 h-64 bg-indigo-50 rounded-full blur-3xl opacity-40"></div>
        <div class="flex items-center gap-8 relative z-10">
            <div class="w-20 h-20 bg-slate-900 rounded-3xl flex items-center justify-center text-white text-3xl font-black shadow-2xl shadow-slate-900/20">
                @User.Identity?.Name?.Substring(0, 1).ToUpper()
            </div>
            <div>
                <h1 class="text-3xl font-black text-slate-900 tracking-tight">Your Projects</h1>
                <p class="text-slate-500 font-bold uppercase tracking-widest text-[11px] mt-1">Personnel Dashboard • @User.Identity?.Name</p>
            </div>
        </div>
        <div class="flex gap-4 relative z-10">
            <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')" class="px-8 py-4 bg-indigo-600 text-white font-black text-xs uppercase tracking-widest rounded-2xl shadow-xl shadow-indigo-600/20 hover:bg-indigo-500 transition-all active:scale-[0.98]">
                + Initialize Project
            </button>
        </div>
    </div>

    <!-- Invitations Section -->
    @{
        var invites = Model.Where(m => !m.IsAccepted).ToList();
    }
    @if (invites.Any())
    {
        <div class="bg-indigo-600 p-10 rounded-[3rem] text-white shadow-2xl shadow-indigo-600/20 animate-in slide-in-from-top duration-700">
            <div class="flex items-center gap-4 mb-8">
                <span class="text-4xl">📩</span>
                <div>
                    <h3 class="text-2xl font-black">Join Team Invites</h3>
                    <p class="text-indigo-200 text-xs font-bold uppercase tracking-widest">Awaiting Acceptance</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var invite in invites)
                {
                    <div class="bg-white/10 backdrop-blur-xl border border-white/20 p-8 rounded-[2rem] flex flex-col justify-between">
                        <div class="mb-6">
                            <p class="text-[10px] font-black uppercase tracking-widest text-indigo-300 mb-2">Membership Requested</p>
                            <h4 class="text-xl font-black">@invite.Project.Name</h4>
                        </div>
                        <form asp-action="AcceptInvite" method="post">
                            <input type="hidden" name="inviteId" value="@invite.MemberId" />
                            <button type="submit" class="w-full bg-white text-indigo-600 py-4 rounded-2xl text-[10px] font-black uppercase tracking-widest shadow-xl hover:bg-indigo-50 transition-all active:scale-[0.98]">
                                Accept Joining
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Accepted Projects Grid -->
    @{
        var active = Model.Where(m => m.IsAccepted).ToList();
    }
    <div class="space-y-8">
        <h2 class="text-xl font-black text-slate-900 ml-2">Active Infrastructure (@active.Count)</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var membership in active)
            {
                <div class="bg-white p-10 rounded-[2.5rem] border border-slate-200 shadow-sm hover:border-indigo-300 transition-all group flex flex-col h-full relative overflow-hidden">
                    <div class="flex items-start justify-between mb-8">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center text-xl border border-slate-100 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors">
                                @(membership.Project.Platform == "iOS" ? "📱" : membership.Project.Platform == "Android" ? "🤖" : "🌐")
                            </div>
                            <div>
                                <span class="px-2 py-0.5 @(membership.IsManager ? "bg-indigo-50 text-indigo-600 border-indigo-100" : "bg-slate-50 text-slate-500 border-slate-100") text-[8px] font-black uppercase tracking-widest rounded border">
                                    @(membership.IsManager ? "MANAGER" : "DEVELOPER")
                                </span>
                            </div>
                        </div>
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">EST. @membership.Project.CreatedDate.ToString("MMM yyyy")</span>
                    </div>

                    <div class="flex-grow">
                        <h3 class="text-2xl font-black text-slate-900 mb-2">@membership.Project.Name</h3>
                        <p class="text-xs text-slate-400 font-bold uppercase tracking-[0.2em] mb-8">@membership.Project.Platform Engine</p>

                        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-10">
                            <p class="text-[9px] text-slate-400 font-black uppercase tracking-widest mb-2">Access Key</p>
                            <code class="text-[11px] font-mono text-indigo-600 truncate block">@membership.Project.ApiKey</code>
                        </div>
                    </div>

                    <div class="space-y-3 mt-auto">
                        <a asp-controller="Dashboard" asp-action="Index" asp-route-projectId="@membership.Project.Id"
                           class="block w-full py-4 bg-indigo-600 text-white text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl text-center shadow-lg shadow-indigo-600/10 hover:bg-indigo-500 transition-all active:scale-[0.98]">
                            Console
                        </a>

                        <div class="flex items-center gap-3">
                            <a asp-controller="Team" asp-action="Index" asp-route-projectId="@membership.Project.Id"
                               class="flex-1 py-4 bg-white border border-slate-200 text-slate-600 text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl text-center hover:bg-slate-50 transition-all active:scale-[0.98]">
                                Team
                            </a>

                            @if (membership.IsManager)
                            {
                                <button type="button" onclick="openDeleteModal('@membership.Project.Id', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(membership.Project.Name))')"
                                        class="flex-1 py-4 bg-white border border-rose-200 text-rose-600 text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-rose-50 transition-all active:scale-[0.98]">
                                    Remove
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Initialization Modal -->
<div id="createProjectModal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md hidden">
    <div class="bg-white w-full max-w-md rounded-[3rem] shadow-2xl overflow-hidden animate-in zoom-in duration-300">
        <div class="p-10 border-b border-slate-100 bg-slate-50/30 flex items-center justify-between">
            <h3 class="text-2xl font-black text-slate-900">Provision Project</h3>
            <button onclick="document.getElementById('createProjectModal').classList.add('hidden')" class="w-12 h-12 flex items-center justify-center rounded-2xl bg-white border border-slate-100 text-slate-400 hover:text-slate-600 transition-colors text-lg">✕</button>
        </div>
        <form asp-action="CreateProject" method="post" class="p-10 space-y-8">
            <div class="space-y-3">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-2">Project Identifier</label>
                <input type="text" name="name" required placeholder="e.g. Sentinel iOS Pro" class="w-full px-6 py-4 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500 font-bold transition-all" />
            </div>
            <div class="space-y-3">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-2">Target Stack</label>
                <select name="platform" class="w-full px-6 py-4 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500 appearance-none font-bold text-slate-700 cursor-pointer">
                    <option value="iOS">Apple iOS</option>
                    <option value="Android">Google Android</option>
                    <option value="Cross-Platform">Cross-Platform (.NET)</option>
                </select>
            </div>
            <button type="submit" class="w-full py-5 bg-indigo-600 text-white text-xs font-black uppercase tracking-widest rounded-2xl shadow-2xl shadow-indigo-600/20 hover:bg-indigo-500 transition-all">Initialize Environment</button>
        </form>
    </div>
</div>

<!-- Standardized Deletion Modal -->
<div id="deleteConfirmModal" class="fixed inset-0 z-[110] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md hidden">
    <div class="bg-white w-full max-w-md rounded-[3rem] shadow-2xl overflow-hidden animate-in zoom-in duration-300">
        <div class="p-12 text-center space-y-8">
            <div class="w-20 h-20 bg-rose-50 text-rose-600 rounded-3xl flex items-center justify-center text-3xl mx-auto shadow-inner">
                ⚠️
            </div>
            <div class="space-y-3">
                <h3 class="text-3xl font-black text-slate-900 leading-tight">Delete Infrastructure?</h3>
                <p class="text-slate-500 text-sm font-medium leading-relaxed px-4">
                    Removing <span id="deleteProjectName" class="font-black text-slate-900 underline decoration-rose-300"></span> will permanently purge all telemetry and historical crash logs. This action cannot be undone.
                </p>
            </div>

            <form id="deleteProjectForm" asp-action="DeleteProject" method="post" class="space-y-4 pt-4">
                <input type="hidden" name="id" id="deleteProjectId" />
                <button type="submit" class="w-full py-5 bg-rose-600 text-white text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl shadow-xl shadow-rose-600/20 hover:bg-rose-500 transition-all active:scale-[0.98]">
                    Yes, Purge Data
                </button>
                <button type="button" onclick="closeDeleteModal()" class="w-full py-4 bg-slate-100 text-slate-400 text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-slate-200 transition-all">
                    Cancel & Keep Safe
                </button>
            </form>
        </div>
        <div class="py-4 bg-slate-50 text-center border-t border-slate-100">
            <p class="text-[9px] font-black text-slate-300 uppercase tracking-[0.4em]">Sentinel Protection Protocol Active</p>
        </div>
    </div>
</div>

<script>
    function openDeleteModal(id, name) {
        document.getElementById('deleteProjectId').value = id;
        document.getElementById('deleteProjectName').innerText = name;
        document.getElementById('deleteConfirmModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        document.getElementById('deleteConfirmModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeDeleteModal();
            document.getElementById('createProjectModal').classList.add('hidden');
        }
    });
</script>
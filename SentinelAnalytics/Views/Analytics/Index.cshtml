@using SentinelAnalytics.Models.Analytics
@model AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <nav class="flex items-center gap-3 text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">
                <a asp-controller="Dashboard" asp-action="Index" asp-route-projectId="@Model.ProjectId" class="hover:text-indigo-600 transition-colors">Crashes</a>
                <span>/</span>
                <span class="text-slate-900">Analytics</span>
            </nav>
            <div>
                <h1 class="text-3xl font-black text-slate-900 tracking-tight">@Model.ProjectName - Events Overview</h1>
                <p class="text-slate-500 font-medium">Global user behavior and session forensics</p>
            </div>
        </div>
    </div>

    <!-- Persistent Filter Bar -->
    <div class="bg-white p-8 rounded-[2.5rem] border border-slate-200 shadow-xl relative overflow-hidden">
        <div class="absolute -right-20 -top-20 w-64 h-64 bg-slate-50 rounded-full blur-3xl opacity-50"></div>
        <form id="analyticsFilterForm" method="get" class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-5 gap-6 items-end relative z-10">
            <input type="hidden" name="projectId" value="@Model.ProjectId" />

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">App Build</label>
                <select name="appVersion" id="filterVersion" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all">
                    <option value="All">All Versions</option>
                    @foreach (var v in Model.AvailableVersions)
                    {
                        <option value="@v" selected="@(Model.SelectedVersion == v ? "selected" : null)">@v</option>
                    }
                </select>
            </div>

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Date From</label>
                <input type="date" name="dateFrom" id="filterDateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
            </div>

            <div class="space-y-1.5">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Date To</label>
                <input type="date" name="dateTo" id="filterDateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
            </div>

            <button type="submit" class="w-full bg-slate-900 text-white px-5 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-xl shadow-slate-900/10 hover:bg-indigo-600 transition-all active:scale-[0.98]">
                Rebuild Analytics
            </button>

            <button type="button" onclick="clearAnalyticsFilters()" class="w-full bg-white border border-slate-200 text-slate-400 px-5 py-4 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-slate-50 transition-all">
                Reset
            </button>
        </form>
    </div>

    <!-- Charts Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- 1. Active Users Chart -->
        <div class="bg-white p-10 rounded-[3rem] border border-slate-200 shadow-sm space-y-8">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-black text-slate-900">Active User Flow</h3>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mt-1">Daily unique user identifiers</p>
                </div>
                <div class="w-10 h-10 bg-indigo-50 rounded-xl flex items-center justify-center text-indigo-600">📈</div>
            </div>
            <div class="h-64">
                <canvas id="activeUsersChart"></canvas>
            </div>
        </div>

        <!-- 2. Session Duration Chart -->
        <div class="bg-white p-10 rounded-[3rem] border border-slate-200 shadow-sm space-y-8">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-black text-slate-900">Session Depth</h3>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mt-1">Time spent per instance</p>
                </div>
                <div class="w-10 h-10 bg-amber-50 rounded-xl flex items-center justify-center text-amber-600">⏱️</div>
            </div>
            <div class="h-64">
                <canvas id="sessionDurationChart"></canvas>
            </div>
        </div>

        <!-- 3. Regional Stats Chart -->
        <div class="bg-white p-10 rounded-[3rem] border border-slate-200 shadow-sm space-y-8">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-black text-slate-900">Global Presence</h3>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mt-1">Top countries by traffic volume</p>
                </div>
                <div class="w-10 h-10 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600">🌍</div>
            </div>
            <div class="h-64">
                <canvas id="regionalChart"></canvas>
            </div>
        </div>

        <!-- 4. Language Stats Chart -->
        <div class="bg-white p-10 rounded-[3rem] border border-slate-200 shadow-sm space-y-8">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-black text-slate-900">Language Identity</h3>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mt-1">Locale distribution</p>
                </div>
                <div class="w-10 h-10 bg-rose-50 rounded-xl flex items-center justify-center text-rose-600">💬</div>
            </div>
            <div class="h-64">
                <canvas id="languageChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // State Persistence
    const STORAGE_KEY = 'sentinel_analytics_filters_@Model.ProjectId';

    document.addEventListener('DOMContentLoaded', () => {
        const savedFilters = JSON.parse(sessionStorage.getItem(STORAGE_KEY));
        if (savedFilters && !window.location.search) {
             const params = new URLSearchParams(savedFilters);
             window.location.search = params.toString();
             return;
        }

        initializeCharts();
    });

    document.getElementById('analyticsFilterForm').addEventListener('submit', function() {
        const formData = new FormData(this);
        const data = {};
        formData.forEach((value, key) => data[key] = value);
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    });

    function clearAnalyticsFilters() {
        sessionStorage.removeItem(STORAGE_KEY);
        window.location.href = window.location.pathname + '?projectId=@Model.ProjectId';
    }

    function initializeCharts() {
        // Chart.js Default Styling
        Chart.defaults.font.family = "'Inter', sans-serif";
        Chart.defaults.font.weight = '700';
        Chart.defaults.color = '#94a3b8';

        // 1. Active Users Line Chart
        new Chart(document.getElementById('activeUsersChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ActiveUsersPerDay.Select(x => x.Label))),
                datasets: [{
                    label: 'Users',
                    data: @Html.Raw(Json.Serialize(Model.ActiveUsersPerDay.Select(x => x.Value))),
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99, 102, 241, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 0,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { border: { display: false }, grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 } } },
                    x: { border: { display: false }, grid: { display: false }, ticks: { font: { size: 9 } } }
                }
            }
        });

        // 2. Session Duration Bar Chart
        new Chart(document.getElementById('sessionDurationChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.SessionDurations.Select(x => x.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.SessionDurations.Select(x => x.Value))),
                    backgroundColor: '#f59e0b',
                    borderRadius: 12
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { border: { display: false }, grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 } } },
                    x: { border: { display: false }, grid: { display: false }, ticks: { font: { size: 10 } } }
                }
            }
        });

        // 3. Regional Doughnut Chart
        new Chart(document.getElementById('regionalChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.RegionalStats.Select(x => x.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.RegionalStats.Select(x => x.Value))),
                    backgroundColor: ['#10b981', '#34d399', '#6ee7b7', '#a7f3d0', '#ecfdf5'],
                    borderWidth: 0,
                    cutout: '75%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { boxWidth: 10, padding: 20, font: { size: 11 } } }
                }
            }
        });

        // 4. Language Polar Area Chart
        new Chart(document.getElementById('languageChart'), {
            type: 'polarArea',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.LanguageStats.Select(x => x.Label))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.LanguageStats.Select(x => x.Value))),
                    backgroundColor: [
                        'rgba(99, 102, 241, 0.7)',
                        'rgba(244, 63, 94, 0.7)',
                        'rgba(16, 185, 129, 0.7)',
                        'rgba(245, 158, 11, 0.7)',
                        'rgba(148, 163, 184, 0.7)'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { r: { grid: { display: false }, ticks: { display: false } } },
                plugins: {
                    legend: { position: 'right', labels: { boxWidth: 10, padding: 20, font: { size: 11 } } }
                }
            }
        });
    }
</script>
@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_Layout";
}

<div class="bg-white py-16 px-6">
    <div class="max-w-4xl mx-auto">
        <div class="mb-12">
            <h1 class="text-4xl font-black text-slate-900 mb-4">Privacy Policy</h1>
            <p class="text-slate-500 font-medium italic">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>

        <div class="prose prose-slate max-w-none space-y-8 text-slate-600 leading-relaxed">
            <section>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">1. Introduction</h2>
                <p>
                    Welcome to <strong>LATec</strong> ("Company", "we", "our", "us"). We are committed to protecting your personal information and your right to privacy. If you have any questions or concerns about this privacy notice, or our practices with regards to your personal information, please contact us.
                </p>
                <p>
                    This Privacy Policy applies to all information collected through our services (which, as described above, includes our Website), as well as any related services, sales, marketing, or events.
                </p>
            </section>

            <section>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">2. Information We Collect</h2>
                <p>
                    As an analytics provider, LATec collects data necessary to monitor the health and performance of mobile applications. This includes:
                </p>
                <ul class="list-disc pl-6 space-y-2 mt-4">
                    <li><strong>Crash Reports:</strong> Stack traces, error messages, and system state at the time of an application failure.</li>
                    <li><strong>Mobile Events:</strong> User interactions, screen views, and custom events triggered within the application.</li>
                    <li><strong>Device Information:</strong> Model, OS version, app version, and hardware identifiers (where permitted).</li>
                    <li><strong>User Account Data:</strong> Name, email address, and authentication credentials for platform administrators.</li>
                </ul>
            </section>

            <section>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">3. How We Use Your Information</h2>
                <p>
                    We use the information we collect to provide, improve, and protect our services, including:
                </p>
                <ul class="list-disc pl-6 space-y-2 mt-4">
                    <li>Facilitating account creation and logon process.</li>
                    <li>Generating real-time crash diagnostics and performance reports.</li>
                    <li>Using <strong>Gemini AI</strong> to analyze stack traces and suggest code remediations.</li>
                    <li>Improving our platform's user experience and technical stability.</li>
                    <li>Complying with legal obligations.</li>
                </ul>
            </section>

            <section>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">4. Data Sharing and Processing</h2>
                <p>
                    LATec does not sell your personal data to third parties. We may share data with:
                </p>
                <ul class="list-disc pl-6 space-y-2 mt-4">
                    <li><strong>Cloud Service Providers:</strong> For hosting our databases and application infrastructure.</li>
                    <li><strong>AI Partners:</strong> We utilize Google Gemini for automated crash analysis. Only technical metadata (stack traces) is transmitted for processing.</li>
                    <li><strong>Legal Requirements:</strong> If required by law to comply with judicial proceedings or court orders.</li>
                </ul>
            </section>

            <section>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">5. Data Retention</h2>
                <p>
                    We will only keep your personal information for as long as it is necessary for the purposes set out in this privacy policy, unless a longer retention period is required or permitted by law. For enterprise customers, data retention policies can be customized via the project settings.
                </p>
            </section>

            <section>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">6. Security</h2>
                <p>
                    We have implemented appropriate technical and organizational security measures designed to protect the security of any personal information we process. However, despite our safeguards and efforts to secure your information, no electronic transmission over the Internet or information storage technology can be guaranteed to be 100% secure.
                </p>
            </section>

            <section>
                <h2 class="text-2xl font-bold text-slate-900 mb-4">7. Contact Us</h2>
                <p>
                    If you have questions or comments about this policy, you may email us at:
                </p>
                <p class="font-bold text-indigo-600 mt-2">
                    privacy@latec-analytics.com
                </p>
        </div>
    </div>
</div>
</div>
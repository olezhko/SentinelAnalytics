@using SentinelAnalytics.Data.Entities
@model List<Project>
@{
    ViewData["Title"] = "User Profile";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex items-center gap-6">
            <div class="w-20 h-20 bg-indigo-600 rounded-2xl flex items-center justify-center text-white text-3xl font-black shadow-xl shadow-indigo-600/20">
                AD
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-900">Developer</h1>
                <p class="text-slate-500 font-medium">@User.Identity?.Name</p>
                <div class="mt-2 flex items-center gap-2">
                    <span class="px-2 py-0.5 bg-indigo-50 text-indigo-600 text-[10px] font-bold uppercase tracking-wider rounded border border-indigo-100">Enterprise Plan</span>
                    <span class="px-2 py-0.5 bg-slate-50 text-slate-500 text-[10px] font-bold uppercase tracking-wider rounded border border-slate-200">System Owner</span>
                </div>
            </div>
        </div>
        <div class="flex gap-3">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button class="px-5 py-2.5 bg-rose-50 border border-rose-100 text-rose-600 font-bold text-sm rounded-xl hover:bg-rose-100 transition-all">Sign Out</button>
            </form>
        </div>
    </div>

    <!-- Project Management -->
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-black text-slate-900">Your Projects (@Model.Count)</h2>
            <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')" class="px-5 py-2.5 bg-indigo-600 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-600/20 hover:bg-indigo-500 transition-all flex items-center gap-2">
                <span class="text-lg">+</span> Create New Project
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var project in Model)
            {
                <div class="bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:border-indigo-300 transition-all group flex flex-col h-full">
                    <div class="flex items-start justify-between mb-6">
                        <div class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center text-xl border border-slate-100 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors">
                            @(project.Platform == "iOS" ? "📱" : project.Platform == "Android" ? "🤖" : "🌐")
                        </div>
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">@project.CreatedDate.ToString("MMM yyyy")</span>
                    </div>

                    <div class="flex-grow">
                        <h3 class="text-xl font-black text-slate-900 mb-1">@project.Name</h3>
                        <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mb-6">@project.Platform Stack</p>

                        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 mb-8">
                            <p class="text-[9px] text-slate-400 font-black uppercase tracking-widest mb-2">API Credential</p>
                            <code class="text-[11px] font-mono text-indigo-600 truncate block">@project.ApiKey</code>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 mt-auto">
                        <a asp-controller="Dashboard" asp-action="Index" asp-route-projectId="@project.Id"
                           class="flex-1 py-3 bg-indigo-600 text-white text-[11px] font-black uppercase tracking-[0.1em] rounded-xl text-center shadow-lg shadow-indigo-600/20 hover:bg-indigo-500 transition-all">
                            Console
                        </a>

                        <button type="button" onclick="openDeleteModal('@project.Id', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(project.Name))')"
                                class="flex-1 py-3 bg-white border border-rose-200 text-rose-600 text-[11px] font-black uppercase tracking-[0.1em] rounded-xl hover:bg-rose-50 transition-all">
                            Remove
                        </button>

                        <button type="button" class="w-12 py-3 bg-slate-50 border border-slate-100 text-slate-400 rounded-xl hover:text-indigo-600 transition-colors text-center">⚙️</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Project Modal -->
<div id="createProjectModal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md hidden">
    <div class="bg-white w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden animate-in zoom-in duration-300">
        <div class="p-8 border-b border-slate-100 flex items-center justify-between bg-slate-50/30">
            <h3 class="text-xl font-black text-slate-900">New Project</h3>
            <button onclick="document.getElementById('createProjectModal').classList.add('hidden')" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-100 text-slate-400 hover:text-slate-600">✕</button>
        </div>
        <form asp-controller="Home" asp-action="CreateProject" method="post" class="p-8 space-y-6">
            <div class="space-y-2">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Project Identifier</label>
                <input type="text" name="name" required placeholder="e.g. Sentinel Global App" class="w-full px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500 font-bold text-slate-700 transition-all" />
            </div>
            <div class="space-y-2">
                <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1">Target Platform</label>
                <select name="platform" class="w-full px-5 py-3.5 bg-slate-50 border border-slate-200 rounded-2xl outline-none focus:ring-2 focus:ring-indigo-500 appearance-none font-bold text-slate-700 cursor-pointer">
                    <option value="iOS">Apple iOS</option>
                    <option value="Android">Google Android</option>
                    <option value="Cross-Platform">Cross-Platform (.NET MAUI)</option>
                </select>
            </div>
            <div class="pt-4 flex gap-4">
                <button type="button" onclick="document.getElementById('createProjectModal').classList.add('hidden')" class="flex-1 py-4 text-xs font-black text-slate-400 uppercase tracking-widest border border-slate-200 rounded-2xl hover:bg-slate-50 transition-all">Cancel</button>
                <button type="submit" class="flex-1 py-4 bg-indigo-600 text-white text-xs font-black uppercase tracking-widest rounded-2xl shadow-xl shadow-indigo-600/20 hover:bg-indigo-500 transition-all">Create</button>
            </div>
        </form>
    </div>
</div>


<!-- Custom Delete Confirmation Modal -->
<div id="deleteConfirmModal" class="fixed inset-0 z-[110] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md hidden">
    <div class="bg-white w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden animate-in zoom-in duration-300">
        <div class="p-10 text-center space-y-6">
            <div class="w-20 h-20 bg-rose-50 text-rose-600 rounded-[2rem] flex items-center justify-center text-3xl mx-auto shadow-inner">
                ⚠️
            </div>
            <div class="space-y-2">
                <h3 class="text-2xl font-black text-slate-900">Delete Project?</h3>
                <p class="text-slate-500 text-sm font-medium leading-relaxed">
                    You are about to permanently remove <span id="deleteProjectName" class="font-black text-slate-900 underline decoration-rose-200"></span>.
                    All historical crash data and events will be purged from the Sentinel core.
                </p>
            </div>

            <form id="deleteProjectForm" asp-controller="Home" asp-action="DeleteProject" method="post" class="space-y-4 pt-4">
                <input type="hidden" name="id" id="deleteProjectId" />
                <button type="submit" class="w-full py-4 bg-rose-600 text-white text-xs font-black uppercase tracking-widest rounded-2xl shadow-xl shadow-rose-600/20 hover:bg-rose-500 transition-all active:scale-[0.98]">
                    Yes, Delete Everything
                </button>
                <button type="button" onclick="closeDeleteModal()" class="w-full py-4 bg-slate-50 text-slate-400 text-xs font-black uppercase tracking-widest rounded-2xl hover:bg-slate-100 transition-all">
                    Cancel
                </button>
            </form>
        </div>
        <div class="py-4 bg-slate-50 text-center border-t border-slate-100">
            <p class="text-[10px] font-black text-slate-300 uppercase tracking-[0.3em]">Destructive Action Warning</p>
        </div>
    </div>
</div>

<script>
    function openDeleteModal(id, name) {
        document.getElementById('deleteProjectId').value = id;
        document.getElementById('deleteProjectName').innerText = name;
        document.getElementById('deleteConfirmModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        document.getElementById('deleteConfirmModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Modal accessibility
    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeDeleteModal();
            document.getElementById('createProjectModal').classList.add('hidden');
        }
    });
</script>
@using SentinelAnalytics.Data.Entities
@model List<Project>
@{
    ViewData["Title"] = "User Profile";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
        <div class="flex items-center gap-6">
            <div class="w-20 h-20 bg-indigo-600 rounded-2xl flex items-center justify-center text-white text-3xl font-black shadow-xl shadow-indigo-600/20">
                AD
            </div>
            <div>
                <h1 class="text-2xl font-black text-slate-900">Developer</h1>
                <p class="text-slate-500 font-medium">@User.Identity?.Name</p>
                <div class="mt-2 flex items-center gap-2">
                    <span class="px-2 py-0.5 bg-indigo-50 text-indigo-600 text-[10px] font-bold uppercase tracking-wider rounded border border-indigo-100">Enterprise Plan</span>
                    <span class="px-2 py-0.5 bg-slate-50 text-slate-500 text-[10px] font-bold uppercase tracking-wider rounded border border-slate-200">System Owner</span>
                </div>
            </div>
        </div>
        <div class="flex gap-3">
            @* <button class="px-5 py-2.5 bg-white border border-slate-200 text-slate-700 font-bold text-sm rounded-xl hover:bg-slate-50 transition-all">Edit Profile</button> *@
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button class="px-5 py-2.5 bg-rose-50 border border-rose-100 text-rose-600 font-bold text-sm rounded-xl hover:bg-rose-100 transition-all">Sign Out</button>
            </form>
        </div>
    </div>

    <!-- Project Management -->
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-black text-slate-900">Your Projects (@Model.Count)</h2>
            <button onclick="document.getElementById('createProjectModal').classList.remove('hidden')" class="px-5 py-2.5 bg-indigo-600 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-600/20 hover:bg-indigo-500 transition-all flex items-center gap-2">
                <span class="text-lg">+</span> Create New Project
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var project in Model)
            {
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:border-indigo-300 transition-all group">
                    <div class="flex items-start justify-between mb-4">
                        <div class="w-10 h-10 bg-slate-50 rounded-lg flex items-center justify-center text-lg border border-slate-100 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-colors">
                            @(project.Platform == "iOS" ? "📱" : project.Platform == "Android" ? "🤖" : "🌐")
                        </div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">@project.CreatedDate.ToString("MMM yyyy")</span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 mb-1">@project.Name</h3>
                    <p class="text-xs text-slate-500 font-medium mb-4">@project.Platform Development</p>

                    <div class="space-y-3">
                        <div class="bg-slate-50 p-2 rounded-lg border border-slate-100 relative">
                            <p class="text-[9px] text-slate-400 font-black uppercase mb-1">API KEY</p>
                            <code class="text-[11px] font-mono text-indigo-600 truncate block">@project.ApiKey</code>
                        </div>
                        <div class="flex gap-2">
                            <a asp-controller="Dashboard" asp-action="Index" asp-route-projectId="@project.Id" class="flex-1 py-2 bg-slate-900 text-white text-xs font-bold rounded-lg text-center hover:bg-indigo-600 transition-colors">Console</a>
                            <button class="w-10 py-2 bg-white border border-slate-200 text-slate-400 rounded-lg hover:text-indigo-600 transition-colors">⚙️</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Simple Create Project Modal -->
<div id="createProjectModal" class="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
    <div class="bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden animate-in zoom-in duration-300">
        <div class="p-8 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-xl font-black text-slate-900">New Project</h3>
            <button onclick="document.getElementById('createProjectModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600">✕</button>
        </div>
        <form asp-controller="Home" asp-action="CreateProject" method="post" class="p-8 space-y-6">
            <div class="space-y-2">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Project Name</label>
                <input type="text" name="name" required placeholder="e.g. Sentinel Mobile" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-medium transition-all" />
            </div>
            <div class="space-y-2">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest">Platform</label>
                <select name="platform" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 appearance-none font-medium cursor-pointer">
                    <option value="iOS">Apple iOS</option>
                    <option value="Android">Google Android</option>
                    <option value="Cross-Platform">Cross-Platform (.NET MAUI)</option>
                    <option value="BE">BE</option>
                </select>
            </div>
            <div class="pt-4 flex gap-3">
                <button type="button" onclick="document.getElementById('createProjectModal').classList.add('hidden')" class="flex-1 py-3 text-sm font-bold text-slate-500 border border-slate-200 rounded-xl hover:bg-slate-50">Cancel</button>
                <button type="submit" class="flex-1 py-3 bg-indigo-600 text-white text-sm font-bold rounded-xl shadow-lg shadow-indigo-600/20 hover:bg-indigo-500">Create Project</button>
            </div>
        </form>
    </div>
</div>

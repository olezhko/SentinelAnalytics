@model List<PricingPlan>
@{
    ViewData["Title"] = "Pricing Plans";
    Layout = "_Layout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center mb-20">
        <h1 class="text-5xl font-black text-slate-900 mb-6 tracking-tight">Scale your infrastructure with confidence</h1>
        <p class="text-xl text-slate-500 font-medium max-w-2xl mx-auto">Choose the plan that fits your team's needs. From solo developers to enterprise-grade operations.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
        @foreach (var plan in Model)
        {
            <div class="bg-white rounded-[3rem] border border-slate-200 p-10 shadow-xl hover:shadow-2xl transition-all flex flex-col relative overflow-hidden group">
                @if (plan.Name == "Pro")
                {
                    <div class="absolute top-0 right-0 bg-indigo-600 text-white px-6 py-2 rounded-bl-3xl text-[10px] font-black uppercase tracking-widest">Most Popular</div>
                }
                
                <div class="mb-10">
                    <h3 class="text-2xl font-black text-slate-900 mb-2">@plan.Name</h3>
                    <p class="text-slate-500 font-medium text-sm">@plan.Description</p>
                </div>

                <div class="mb-10">
                    <div class="flex items-baseline gap-1">
                        <span class="text-5xl font-black text-slate-900">$@plan.Price.ToString("F0")</span>
                        <span class="text-slate-400 font-bold">/mo</span>
                    </div>
                </div>

                <div class="space-y-4 mb-12 flex-1">
                    <div class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs font-bold">✓</span>
                        <span class="text-slate-700 font-bold">@plan.MaxProjects Projects</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs font-bold">✓</span>
                        <span class="text-slate-700 font-bold">@plan.MaxEventsPerMonth.ToString("N0") Events/mo</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs font-bold">✓</span>
                        <span class="text-slate-700 font-bold">@plan.MaxCrashesPerMonth.ToString("N0") Crashes/mo</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="w-6 h-6 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs font-bold">✓</span>
                        <span class="text-slate-700 font-bold">@plan.MaxTeamMembersPerProject Team Members</span>
                    </div>
                </div>

                @if (!SignInManager.IsSignedIn(User))
                {
                    <a href="/Identity/Account/Register" class="w-full py-5 @(plan.Name == "Pro" ? "bg-indigo-600 text-white shadow-indigo-200" : "bg-slate-900 text-white shadow-slate-200") rounded-3xl font-black text-center shadow-2xl hover:scale-[1.02] transition-all">
                        Get Started
                    </a>
                }
                else
                {
                    
                }
            </div>
        }
    </div>

    <div class="mt-24 bg-slate-900 rounded-[4rem] p-16 text-center relative overflow-hidden">
        <div class="absolute -top-20 -right-20 w-80 h-80 bg-indigo-600/20 rounded-full blur-3xl"></div>
        <div class="relative z-10">
            <h2 class="text-3xl font-black text-white mb-6">Need more scale?</h2>
            <p class="text-slate-400 font-medium mb-10 max-w-xl mx-auto">We offer custom enterprise solutions for high-volume applications and dedicated support requirements.</p>
            <a href="/Home/Support" class="inline-block px-10 py-5 bg-white text-slate-900 font-black rounded-3xl hover:bg-slate-100 transition-all">Contact Sales</a>
        </div>
    </div>
</div>

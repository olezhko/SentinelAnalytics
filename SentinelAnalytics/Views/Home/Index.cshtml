@{
    ViewData["Title"] = "Sentinel Analytics";
    Layout = "_Layout";
}

<div class="bg-slate-900 text-white py-24 px-6 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_30%_50%,#4f46e5,transparent_50%)]"></div>
    <div class="max-w-7xl mx-auto relative z-10 grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-400/20 text-indigo-400 text-xs font-bold tracking-widest uppercase">
                <span class="flex h-2 w-2 rounded-full bg-indigo-400 animate-pulse"></span>
                Gemini AI Integrated
            </div>
            <h1 class="text-5xl lg:text-7xl font-black leading-tight">
                Secure your <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-emerald-400">Mobile Stack</span>.
            </h1>
            <p class="text-xl text-slate-400 max-w-lg">
                The first analytics platform built specifically for .NET teams monitoring high-stakes mobile environments.
            </p>
            <div class="flex gap-4">
                <a asp-controller="Dashboard" asp-action="Demo" class="px-8 py-4 bg-indigo-600 rounded-2xl font-bold shadow-2xl hover:bg-indigo-500 transition-all transform hover:-translate-y-1">Explore Demo</a>
                <a asp-controller="Home" asp-action="UserProfile" class="px-8 py-4 bg-white/5 rounded-2xl font-bold border border-white/10 hover:bg-white/10 transition-all">Create Account</a>
            </div>
        </div>
        <div class="hidden lg:block">
            <div class="bg-slate-800 rounded-3xl p-8 border border-white/5 shadow-2xl rotate-2 translate-x-12 cursor-pointer" onclick="window.location.href='/Dashboard/Demo'">
                <div class="flex gap-2 mb-6">
                    <div class="w-3 h-3 rounded-full bg-rose-500"></div>
                    <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                    <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
                </div>
                <div class="space-y-4">
                    <div class="h-4 w-3/4 bg-white/10 rounded"></div>
                    <div class="h-4 w-1/2 bg-white/5 rounded"></div>
                    <div class="h-32 bg-indigo-500/10 rounded-xl border border-indigo-500/20 flex items-center justify-center">
                        <span class="text-xs font-bold text-indigo-400">Interactive Demo Preview</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="py-24 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-3xl font-black text-slate-900">Why Sentinel?</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-12">
            <div class="space-y-4">
                <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center text-indigo-600 text-xl font-bold">01</div>
                <h4 class="text-xl font-bold text-slate-900">Event Correlation</h4>
                <p class="text-slate-500">Automatically tie mobile user events to server-side logs using Session IDs.</p>
            </div>
            <div class="space-y-4">
                <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center text-emerald-600 text-xl font-bold">02</div>
                <h4 class="text-xl font-bold text-slate-900">C# Fix Engine</h4>
                <p class="text-slate-500">Gemini AI analyzes stack traces and provides ready-to-paste C# code snippets.</p>
            </div>
            <div class="space-y-4">
                <div class="w-12 h-12 bg-rose-100 rounded-xl flex items-center justify-center text-rose-600 text-xl font-bold">03</div>
                <h4 class="text-xl font-bold text-slate-900">High Capacity</h4>
                <p class="text-slate-500">Built on EF Core and optimized for MSSQL to handle millions of data points daily.</p>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
<section class="py-24 bg-slate-50 border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <h3 class="text-3xl font-black text-slate-900 mb-8">Ready to secure your production app?</h3>
        <div class="bg-white p-2 rounded-2xl shadow-sm border border-slate-200 inline-flex mb-12">
            <code class="px-6 py-3 font-mono text-sm text-indigo-600 bg-slate-50 rounded-xl border border-slate-100">
                dotnet add package SentinelAnalytics.MAUI
            </code>
        </div>
        <div class="mt-4">
            <a asp-controller="Dashboard" asp-action="Demo" class="inline-block px-12 py-5 bg-slate-900 hover:bg-indigo-600 text-white font-bold rounded-2xl shadow-2xl transition-all">
                Enter Demo
            </a>
        </div>
    </div>
</section>
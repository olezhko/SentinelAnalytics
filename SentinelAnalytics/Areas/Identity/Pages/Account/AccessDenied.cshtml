@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Restricted";
    Layout = "_Layout";
}

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-lg w-full space-y-10 bg-white p-12 rounded-[3rem] border border-slate-200 shadow-2xl relative overflow-hidden text-center">
        <!-- Security Pulse Element -->
        <div class="absolute top-0 left-0 w-full h-1.5 bg-rose-500"></div>
        <div class="absolute -right-20 -top-20 w-64 h-64 bg-rose-50 rounded-full blur-3xl opacity-40"></div>

        <div class="relative z-10 flex flex-col items-center">
            <!-- Restricted Icon -->
            <div class="w-24 h-24 bg-rose-50 text-rose-600 rounded-[2.5rem] flex items-center justify-center text-4xl shadow-inner mb-8 animate-pulse">
                🚫
            </div>

            <div class="space-y-4">
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-rose-50 text-rose-600 rounded-full text-[10px] font-black uppercase tracking-[0.2em] border border-rose-100 mb-2">
                    Security Protocol Intercept
                </div>
                <h1 class="text-4xl font-black text-slate-900 tracking-tight leading-none">Access Restricted</h1>
                <p class="text-slate-500 font-medium text-lg leading-relaxed px-4">
                    Your current credentials lack the necessary authorization level to access this infrastructure segment.
                </p>
            </div>

            <!-- Contextual Info -->
            <div class="w-full mt-10 p-6 bg-slate-50 border border-slate-100 rounded-3xl text-left space-y-4">
                <div class="flex justify-between items-center border-b border-slate-200 pb-3">
                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Error Code</span>
                    <span class="font-mono text-[10px] text-slate-900 font-bold">403_FORBIDDEN_INGRESS</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Logged Identity</span>
                    <span class="text-[11px] text-indigo-600 font-black">@User.Identity?.Name</span>
                </div>
            </div>

            <!-- Recovery Actions -->
@*             <div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-4 mt-10">
                <a asp-controller="Home" asp-action="Projects"
                   class="py-4 bg-slate-900 text-white text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl shadow-xl hover:bg-slate-800 transition-all active:scale-[0.98]">
                    Return to Console
                </a>
                <a asp-area="Identity" asp-page="/Account/Login"
                   class="py-4 bg-white border border-slate-200 text-slate-600 text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-slate-50 transition-all active:scale-[0.98]">
                    Switch Account
                </a>
            </div> *@
        </div>

@*         <div class="pt-8 border-t border-slate-50">
            <p class="text-[9px] font-black text-slate-300 uppercase tracking-[0.4em]">Sentinel Security Firewall v2.4.0</p>
        </div> *@
    </div>
</div>
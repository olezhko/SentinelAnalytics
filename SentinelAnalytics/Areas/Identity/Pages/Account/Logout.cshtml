@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="min-h-[85vh] flex items-center justify-center p-6 bg-slate-50">
    <div class="max-w-md w-full text-center space-y-10 bg-white p-12 rounded-[3rem] border border-slate-200 shadow-2xl relative overflow-hidden">
        <!-- Brand Accent -->
        <div class="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-indigo-500 to-rose-500"></div>

        <div class="flex justify-center">
            <div class="w-24 h-24 bg-slate-900 rounded-[2.5rem] flex items-center justify-center text-4xl shadow-2xl animate-in zoom-in duration-500">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <span>🔒</span>
                }
                else
                {

                    <span>👋</span>
                }
            </div>
        </div>

        <div class="space-y-3">
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <h1 class="text-3xl font-black text-slate-900 tracking-tight leading-tight">Confirm Termination</h1>
                <p class="text-slate-500 font-medium px-4">You are currently active in the Sentinel secure network. Are you sure you wish to end your session?</p>
            }
            else
            {
                <h1 class="text-3xl font-black text-slate-900 tracking-tight leading-tight">Session Ended</h1>
                <p class="text-slate-500 font-medium px-4">Your enterprise credentials have been cleared and your session has been successfully terminated.</p>
            }
        </div>

        <div class="space-y-4">
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="w-full py-5 bg-rose-600 text-white font-black rounded-2xl shadow-lg shadow-rose-600/20 hover:bg-rose-500 transition-all active:scale-[0.98]">
                        Confirm Log Out
                    </button>
                </form>
                <a href="javascript:history.back()" class="block w-full py-4 bg-slate-50 text-slate-600 font-bold rounded-2xl border border-slate-200 hover:bg-slate-100 transition-all">
                    Cancel & Stay
                </a>
            }
            else
            {
                <a href="/" class="block w-full py-5 bg-indigo-600 text-white font-black rounded-2xl shadow-lg shadow-indigo-600/20 hover:bg-indigo-500 transition-all active:scale-[0.98]">
                    Return to Landing
                </a>
                <a asp-page="./Login" class="block text-xs font-black text-slate-400 uppercase tracking-widest hover:text-indigo-600 transition-colors pt-4">
                    Sign in to a different account
                </a>
            }
        </div>

        <div class="pt-6 border-t border-slate-50">
            <p class="text-[10px] font-black text-slate-300 uppercase tracking-[0.3em]">Sentinel Security Protocol v2.4</p>
        </div>
    </div>
</div>

@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-[2.5rem] border border-slate-200 shadow-xl">
        <div class="text-center">
            <div class="mx-auto h-12 w-12 bg-indigo-600 rounded-2xl flex items-center justify-center text-white font-black text-xl shadow-lg shadow-indigo-600/20 mb-6">S</div>
            <h2 class="text-3xl font-black text-slate-900 tracking-tight">Welcome Back</h2>
            <p class="mt-2 text-sm font-medium text-slate-500 uppercase tracking-widest">Access the Sentinel Console</p>
        </div>

        <form id="account" method="post" class="mt-8 space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs font-bold bg-rose-50 p-4 rounded-xl border border-rose-100"></div>

            <div class="space-y-4">
                <div class="space-y-1">
                    <label asp-for="Input.Email" class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1"></label>
                    <input asp-for="Input.Email" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 font-medium transition-all" placeholder="name@company.com" />
                    <span asp-validation-for="Input.Email" class="text-rose-500 text-[10px] font-bold"></span>
                </div>
                <div class="space-y-1">
                    <label asp-for="Input.Password" class="text-[10px] font-black text-slate-400 uppercase tracking-widest ml-1"></label>
                    <input type="password" asp-for="Input.Password" class="block w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 font-medium transition-all" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="text-rose-500 text-[10px] font-bold"></span>
                </div>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <input asp-for="Input.RememberMe" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-slate-300 rounded" />
                    <label asp-for="Input.RememberMe" class="ml-2 block text-xs font-bold text-slate-500 uppercase tracking-wider"></label>
                </div>
                <div class="text-xs">
                    <a id="forgot-password" asp-area="Identity" asp-page="/Account/ForgotPassword" class="font-bold text-indigo-600 hover:text-indigo-500 transition-colors">Forgot password?</a>
                </div>
            </div>

            <div>
                <button type="submit" class="group relative w-full flex justify-center py-4 px-4 bg-indigo-600 text-white font-black rounded-2xl hover:bg-indigo-500 transition-all shadow-lg shadow-indigo-600/20 active:scale-[0.98]">
                    Authenticate Securely
                </button>
            </div>
        </form>

        <div class="mt-6 pt-6 border-t border-slate-100 text-center">
            <p class="text-xs text-slate-400 font-medium">
                New to Sentinel?
                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="font-bold text-indigo-600 hover:underline">
                    Create an enterprise account
                </a>
            </p>
        </div>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) != 0)
            {
                <div class="mt-6 pt-6 border-t border-slate-100 text-center">
                    <hr />

                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

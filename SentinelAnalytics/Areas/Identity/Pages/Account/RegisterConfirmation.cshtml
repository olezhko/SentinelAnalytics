@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<div class="min-h-[85vh] flex items-center justify-center p-6 bg-slate-50">
    <div class="max-w-md w-full text-center space-y-10 bg-white p-12 rounded-[3rem] border border-slate-200 shadow-2xl relative overflow-hidden">
        <!-- Security Accent -->
        <div class="absolute top-0 left-0 w-full h-1.5 bg-indigo-600"></div>

        <div class="flex justify-center">
            <div class="w-24 h-24 bg-indigo-50 rounded-[2.5rem] flex items-center justify-center text-4xl shadow-inner animate-bounce">
                <span>📧</span>
            </div>
        </div>

        <div class="space-y-4">
            <h1 class="text-3xl font-black text-slate-900 tracking-tight leading-tight">Check Your Inbox</h1>
            <div class="space-y-2">
                <p class="text-slate-600 font-bold">Please check your email to confirm your account.</p>
                <p class="text-slate-400 text-sm font-medium px-4">
                    We've sent a verification link to your registered corporate address.
                    This step is mandatory to maintain the integrity of our high-security analytics network.
                </p>
            </div>
        </div>

        <div class="space-y-4">
            <div class="p-6 bg-slate-50 rounded-3xl border border-slate-100 space-y-3">
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest text-center">Didn't receive the email?</p>
                <p class="text-[11px] text-slate-500 leading-relaxed">
                    Check your spam folder or contact your system administrator. Verification links expire in 24 hours.
                </p>
            </div>

            <a asp-page="./Login" class="block w-full py-5 bg-slate-900 text-white font-black rounded-2xl shadow-lg shadow-slate-900/10 hover:bg-indigo-600 transition-all active:scale-[0.98]">
                Back to Login
            </a>
        </div>
    </div>
</div>
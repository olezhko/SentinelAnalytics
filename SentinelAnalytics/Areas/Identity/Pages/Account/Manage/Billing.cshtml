@page
@using SentinelAnalytics.Data.Entities
@model BillingModel
@{
    ViewData["Title"] = "Billing";
    ViewData["ActivePage"] = ManageNavPages.Billing;
    var isPaidPlan = Model.HasActivePlan && Model.CurrentUserDetail?.Plan?.Price > 0;
}

<div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex items-center justify-between">
        <div class="space-y-1">
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">Identity & Profile</h1>
            <p class="text-slate-500 font-medium">Manage your personal credentials and console preferences.</p>
        </div>
        <div class="h-14 w-14 bg-indigo-600 rounded-2xl flex items-center justify-center text-white font-black text-xl shadow-xl shadow-indigo-600/20">
            @Model.Username.Substring(0, 1).ToUpper()
        </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-10">
        <!-- Navigation -->
        <div class="lg:col-span-1">
            <nav class="flex flex-col gap-1">
                <a asp-page="./Index" class="px-5 py-3 rounded-xl text-sm font-black text-slate-500 hover:bg-white hover:text-indigo-600 transition-all border border-transparent hover:border-slate-200">General Info</a>
                <a asp-page="./Subscription" class="px-5 py-3 rounded-xl text-sm font-black text-slate-500 hover:bg-white hover:text-indigo-600 transition-all border border-transparent hover:border-slate-200">Subscription</a>
                <a asp-page="./Billing" class="px-5 py-3 rounded-xl text-sm font-black bg-indigo-600 text-white shadow-lg shadow-indigo-600/10 transition-all">Billing</a>
            </nav>
        </div>

        <!-- Form Content -->
        <div class="lg:col-span-2 space-y-8">

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-semibold">
                    @Model.StatusMessage
                </div>
            }

            <div id="stripe-error" class="hidden px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm font-semibold"></div>
            <div asp-validation-summary="ModelOnly" class="px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm font-semibold"></div>

            @if (Model.HasActivePlan)
            {
                <!-- Current Plan Summary -->
                <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-3 shadow-sm">
                    <div class="flex items-center justify-between">
                        <h2 class="text-lg font-black text-slate-900">Current Plan</h2>
                        <span class="px-3 py-1 rounded-full text-xs font-black bg-indigo-100 text-indigo-700 uppercase tracking-wide">
                            @(Model.CurrentUserDetail.StripeSubscriptionStatus ?? "Active")
                        </span>
                    </div>
                    <div class="flex items-end gap-2">
                        <span class="text-3xl font-black text-slate-900">@Model.CurrentUserDetail.Plan.Name</span>
                        <span class="text-slate-500 font-semibold mb-0.5">
                            @(Model.CurrentUserDetail.Plan.Price == 0 ? "Free" : $"${Model.CurrentUserDetail.Plan.Price}/mo")
                        </span>
                    </div>
                    <p class="text-xs text-slate-400 font-semibold uppercase">Active since @Model.CurrentUserDetail.StartDate.ToString("MMMM d, yyyy")</p>
                </div>

                <!-- Saved Payment Method -->
                @if (!string.IsNullOrEmpty(Model.CurrentUserDetail.CardLastFour))
                {
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-3 shadow-sm">
                        <h2 class="text-lg font-black text-slate-900">Payment Method</h2>
                        <div class="flex items-center gap-4">
                            <div class="h-10 w-16 bg-slate-100 rounded-lg flex items-center justify-center text-xs font-black text-slate-600 uppercase">
                                @Model.CurrentUserDetail.CardBrand
                            </div>
                            <div>
                                <p class="text-sm font-black text-slate-900">•••• •••• •••• @Model.CurrentUserDetail.CardLastFour</p>
                                <p class="text-xs text-slate-500">
                                    Expires @Model.CurrentUserDetail.CardExpiry
                                    @if (!string.IsNullOrEmpty(Model.CurrentUserDetail.CardholderName))
                                    {
                                        <span>· @Model.CurrentUserDetail.CardholderName</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Saved Billing Address -->
                @if (!string.IsNullOrEmpty(Model.CurrentUserDetail.BillingAddress))
                {
                    <div class="bg-white rounded-2xl border border-slate-200 p-6 space-y-1 shadow-sm">
                        <h2 class="text-lg font-black text-slate-900">Billing Address</h2>
                        <p class="text-sm text-slate-600">@Model.CurrentUserDetail.BillingAddress</p>
                        <p class="text-sm text-slate-600">
                            @Model.CurrentUserDetail.BillingCity@(!string.IsNullOrEmpty(Model.CurrentUserDetail.BillingState) ? $", {Model.CurrentUserDetail.BillingState}" : "")
                            @Model.CurrentUserDetail.BillingZip
                        </p>
                        <p class="text-sm text-slate-600">@Model.CurrentUserDetail.BillingCountry</p>
                    </div>
                }

                <!-- Update / Change Plan -->
                <details class="group">
                    <summary class="cursor-pointer list-none">
                        <div class="px-5 py-3 rounded-xl border border-slate-200 text-sm font-black text-slate-600 hover:border-indigo-400 hover:text-indigo-600 transition-all flex items-center justify-between">
                            <span>Update Payment Method or Change Plan</span>
                            <svg class="w-4 h-4 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </div>
                    </summary>
                    <div class="mt-4">
                        @await Html.PartialAsync("_BillingForm", Model)
                    </div>
                </details>
            }
            else
            {
                <div class="space-y-2">
                    <h2 class="text-lg font-black text-slate-900">Choose a Plan</h2>
                    <p class="text-sm text-slate-500">Select the plan that fits your needs. You can upgrade or downgrade at any time.</p>
                </div>

                <!-- Plan Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    @foreach (var plan in Model.AvailablePlans)
                    {
                        <button type="button"
                                onclick="selectPlan('@plan.Id', '@plan.Name', @plan.Price.ToString("0"))"
                                data-plan-id="@plan.Id"
                                class="plan-card text-left p-5 rounded-2xl border-2 border-slate-200 hover:border-indigo-400 transition-all space-y-2 group">
                            <p class="text-base font-black text-slate-900 group-hover:text-indigo-600 transition-colors">@plan.Name</p>
                            <p class="text-2xl font-black text-slate-900">
                                @(plan.Price == 0 ? "Free" : $"${plan.Price}")
                                @if (plan.Price > 0) { <span class="text-sm text-slate-400 font-semibold">/mo</span> }
                            </p>
                            <p class="text-xs text-slate-500">@plan.Description</p>
                            <ul class="text-xs text-slate-500 space-y-1 pt-1">
                                <li>@plan.MaxProjects project@(plan.MaxProjects != 1 ? "s" : "")</li>
                                <li>@plan.MaxEventsPerMonth.ToString("N0") events/mo</li>
                                <li>@plan.MaxTeamMembersPerProject members/project</li>
                            </ul>
                        </button>
                    }
                </div>

                <div id="billing-form-section" class="hidden">
                    @await Html.PartialAsync("_BillingForm", Model)
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        // Called by outer plan cards (no-plan view).
        // Reveals the form first, THEN mounts Stripe so it renders into a visible element.
        function selectPlan(planId, planName, planPrice) {
            document.querySelectorAll('.plan-card').forEach(c => {
                c.classList.remove('border-indigo-600', 'bg-indigo-50');
                c.classList.add('border-slate-200');
            });
            const card = document.querySelector(`[data-plan-id="${planId}"]`);
            if (card) {
                card.classList.remove('border-slate-200');
                card.classList.add('border-indigo-600', 'bg-indigo-50');
            }

            // Update form inputs and toggle billing section visibility
            _applyPlanToForm(planId, planName, planPrice);

            // Reveal the form wrapper before mounting Stripe
            const section = document.getElementById('billing-form-section');
            if (section) section.classList.remove('hidden');

            if (planPrice > 0 && typeof window.mountStripeCard === 'function') {
                window.mountStripeCard();
            }
        }

        // Called by inline plan cards (has-plan view).
        // <details> is already open so the section is visible — mount immediately.
        function setPlanInForm(planId, planName, planPrice) {
            _applyPlanToForm(planId, planName, planPrice);

            // Update inline card visual selection
            document.querySelectorAll('.plan-card-inline').forEach(c => {
                c.classList.remove('border-indigo-600', 'bg-indigo-50');
                c.classList.add('border-slate-200', 'hover:border-indigo-400');
                const name = c.querySelector('p');
                if (name) { name.classList.remove('text-indigo-700'); name.classList.add('text-slate-900'); }
            });
            const selected = document.querySelector(`[data-plan-id-inline="${planId}"]`);
            if (selected) {
                selected.classList.remove('border-slate-200', 'hover:border-indigo-400');
                selected.classList.add('border-indigo-600', 'bg-indigo-50');
                const name = selected.querySelector('p');
                if (name) { name.classList.remove('text-slate-900'); name.classList.add('text-indigo-700'); }
            }

            if (planPrice > 0 && typeof window.mountStripeCard === 'function') {
                window.mountStripeCard();
            }
        }

        // Shared: update hidden inputs and toggle the billing/card section.
        function _applyPlanToForm(planId, planName, planPrice) {
            const input = document.getElementById('selected-plan-id');
            if (input) input.value = planId;
            const label = document.getElementById('selected-plan-label');
            if (label) label.textContent = planName + (planPrice > 0 ? ` — $${planPrice}/mo` : ' — Free');
            const cardSection = document.getElementById('card-section');
            if (cardSection) cardSection.classList.toggle('hidden', planPrice == 0);
        }

        // Paid-plan users: mount Stripe when they expand the <details> update form.
        const detailsEl = document.querySelector('details');
        if (detailsEl) {
            detailsEl.addEventListener('toggle', function () {
                if (!this.open) return;
                const cardSection = document.getElementById('card-section');
                if (cardSection && !cardSection.classList.contains('hidden') && typeof window.mountStripeCard === 'function') {
                    window.mountStripeCard();
                }
            });
        }
    </script>
}

@model BillingModel

@{
    var currentPlanIsFree = Model.HasActivePlan && (Model.CurrentUserDetail?.Plan?.Price ?? 0) == 0;
    var showBillingByDefault = Model.HasActivePlan && !currentPlanIsFree;
}

<form id="billing-form" method="post" class="space-y-6">
    <input type="hidden" asp-for="Input.SelectedPlanId" id="selected-plan-id" />
    <input type="hidden" asp-for="Input.PaymentMethodId" id="payment-method-id" />

    @* Current plan badge *@
    @if (Model.HasActivePlan)
    {
        var plan = Model.CurrentUserDetail.Plan;
        var isFree = plan.Price == 0;
        <div class="flex items-center justify-between px-4 py-3 bg-slate-50 rounded-xl border border-slate-200">
            <div>
                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-0.5">Current Plan</p>
                <p class="text-sm font-black text-slate-900">@plan.Name</p>
            </div>
            <span class="text-sm font-black @(isFree ? "text-slate-500" : "text-indigo-700")">
                @(isFree ? "Free" : $"${plan.Price}/mo")
            </span>
        </div>
    }

    @* Plan selector *@
    <div class="space-y-2">
        <p class="text-xs font-black text-slate-600 uppercase tracking-wider">
            @(Model.HasActivePlan ? "Change Plan" : "Plan")
        </p>
        @if (Model.HasActivePlan)
        {
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                @foreach (var plan in Model.AvailablePlans)
                {
                    var isSelected = plan.Id == Model.CurrentUserDetail.PlanId;
                    <button type="button"
                            onclick="setPlanInForm('@plan.Id', '@plan.Name', @plan.Price.ToString("0"))"
                            data-plan-id-inline="@plan.Id"
                            class="plan-card-inline text-left p-4 rounded-xl border-2 transition-all @(isSelected ? "border-indigo-600 bg-indigo-50" : "border-slate-200 hover:border-indigo-400")">
                        <p class="text-sm font-black @(isSelected ? "text-indigo-700" : "text-slate-900")">@plan.Name</p>
                        <p class="text-sm font-semibold text-slate-500">@(plan.Price == 0 ? "Free" : $"${plan.Price}/mo")</p>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="px-4 py-3 bg-indigo-50 rounded-xl border border-indigo-200">
                <p class="text-sm font-black text-indigo-700">Selected: <span id="selected-plan-label">—</span></p>
            </div>
        }
    </div>

    @* Payment + billing address — hidden for free plans, revealed by JS when a paid plan is chosen *@
    <div id="card-section" class="@(showBillingByDefault ? "" : "hidden") space-y-6">

        <div class="space-y-4">
            <h3 class="text-xs font-black text-slate-700 uppercase tracking-wider">Payment Details</h3>

            @if (Model.HasActivePlan && !string.IsNullOrEmpty(Model.CurrentUserDetail?.CardLastFour))
            {
                <p class="text-xs text-slate-500">Leave card blank to keep •••• @Model.CurrentUserDetail.CardLastFour.</p>
            }

            <div>
                <label class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-1">Card</label>
                <div id="card-element"
                     class="px-4 py-3 rounded-xl border border-slate-200 bg-white focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-transparent">
                </div>
                <div id="card-element-errors" class="mt-1 text-xs text-rose-500 font-semibold"></div>
            </div>
        </div>

        <div class="space-y-4">
            <h3 class="text-xs font-black text-slate-700 uppercase tracking-wider">Billing Address</h3>

            <div>
                <label asp-for="Input.BillingAddress" class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-1"></label>
                <input asp-for="Input.BillingAddress" placeholder="123 Main Street"
                       class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder:text-slate-300" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Input.BillingCity" class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-1"></label>
                    <input asp-for="Input.BillingCity" placeholder="New York"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder:text-slate-300" />
                </div>
                <div>
                    <label asp-for="Input.BillingState" class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-1"></label>
                    <input asp-for="Input.BillingState" placeholder="NY"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder:text-slate-300" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Input.BillingZip" class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-1"></label>
                    <input asp-for="Input.BillingZip" placeholder="10001"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder:text-slate-300" />
                </div>
                <div>
                    <label asp-for="Input.BillingCountry" class="block text-xs font-black text-slate-600 uppercase tracking-wider mb-1"></label>
                    <input asp-for="Input.BillingCountry" placeholder="United States"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 placeholder:text-slate-300" />
                </div>
            </div>
        </div>
    </div>

    <button id="submit-btn" type="submit"
            class="w-full py-4 bg-slate-900 text-white font-black rounded-2xl shadow-lg hover:bg-indigo-600 transition-all active:scale-[0.98] disabled:opacity-50">
        @(Model.HasActivePlan ? "Save Changes" : "Subscribe")
    </button>
</form>

<script>
    (function () {
        const publishableKey = '@Model.StripePublishableKey';
        if (!publishableKey || publishableKey.includes('REPLACE_ME')) return;

        // stripe and cardElement are null until mountStripeCard() runs.
        // By submission time the user must have gone through plan selection,
        // which triggers mountStripeCard, so both will be set.
        let stripe = null;
        let cardElement = null;
        let mounted = false;

        // Called from Billing.cshtml AFTER Stripe.js has loaded and the card
        // section is visible, so the iframe renders at the correct size.
        window.mountStripeCard = function () {
            if (mounted) return;
            mounted = true;

            stripe = Stripe(publishableKey);
            const elements = stripe.elements();

            cardElement = elements.create('card', {
                style: {
                    base: {
                        fontFamily: 'Inter, sans-serif',
                        fontSize: '14px',
                        fontWeight: '600',
                        color: '#0f172a',
                        '::placeholder': { color: '#cbd5e1' },
                    },
                    invalid: { color: '#f43f5e' },
                },
                hidePostalCode: true,
            });

            cardElement.mount('#card-element');

            cardElement.on('change', ({ error }) => {
                const display = document.getElementById('card-element-errors');
                display.textContent = error ? error.message : '';
            });
        };

        document.getElementById('billing-form').addEventListener('submit', async function (e) {
            const cardSection = document.getElementById('card-section');
            const cardIsVisible = cardSection && !cardSection.classList.contains('hidden');

            if (!cardIsVisible) return; // free plan — submit directly without Stripe

            e.preventDefault();

            const submitBtn = document.getElementById('submit-btn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Processing…';

            const { paymentMethod, error } = await stripe.createPaymentMethod({
                type: 'card',
                card: cardElement,
                billing_details: {
                    address: {
                        line1: document.querySelector('[name="Input.BillingAddress"]')?.value,
                        city: document.querySelector('[name="Input.BillingCity"]')?.value,
                        state: document.querySelector('[name="Input.BillingState"]')?.value,
                        postal_code: document.querySelector('[name="Input.BillingZip"]')?.value,
                        country: document.querySelector('[name="Input.BillingCountry"]')?.value,
                    }
                },
            });

            if (error) {
                document.getElementById('card-element-errors').textContent = error.message;
                const globalErr = document.getElementById('stripe-error');
                if (globalErr) { globalErr.textContent = error.message; globalErr.classList.remove('hidden'); }
                submitBtn.disabled = false;
                submitBtn.textContent = '@(Model.HasActivePlan ? "Save Changes" : "Subscribe")';
            } else {
                document.getElementById('payment-method-id').value = paymentMethod.id;
                this.submit();
            }
        });
    })();
</script>
